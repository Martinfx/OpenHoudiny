#usda 1.0
(
    defaultPrim = "Crate"
    metersPerUnit = 0.01
    upAxis = "Z"
)

def Xform "Crate" (
    kind = "component"
    variants = {
        string size = "small"
    }
    prepend variantSets = "size"
)
{
    variantSet "size" = {
        "large" {
            def Cube "box"
            {
                color3f[] primvars:displayColor = [(0.45, 0.33, 0.2)]
                double size = 80
                double3 xformOp:translate = (0, 0, 40)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

        }
        "small" {
            def Cube "box"
            {
                color3f[] primvars:displayColor = [(0.45, 0.33, 0.2)]
                double size = 50
                double3 xformOp:translate = (0, 0, 25)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }

        }
    }
}

