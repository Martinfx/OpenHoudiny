pgshadergraph 1
# Vertex animation: every vertex moves along its normal by
# sin(8 * height + 3 * time) * 0.06. The offset input is computed per vertex.
node 1 position 1 20 40
node 2 split 1 190 20
node 3 multiply 1 360 20
  in b 8.0
node 4 time 1 20 200
node 5 multiply 1 360 180
  in b 3.0
node 6 add 1 530 100
node 7 sine 1 700 100
node 8 multiply 1 870 100
  in b 0.06
node 9 normal 1 20 470
node 10 multiply 1 190 400
node 11 lambert 1 190 560
  in color 0.95 0.55 0.2
node 12 surface_output 1 400 450
link 1.position -> 2.vector
link 2.y -> 3.a
link 4.time -> 5.a
link 3.result -> 6.a
link 5.result -> 6.b
link 6.result -> 7.x
link 7.result -> 8.a
link 8.result -> 10.a
link 9.normal -> 10.b
link 11.result -> 12.color
link 10.result -> 12.offset
