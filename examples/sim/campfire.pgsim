pgsim 1
# A campfire: a flickering ball of fuel just above the floor. Turbulence where
# the gas is hot breaks the flames up; the soot above them is dark.
node 1 pyro_source 2 fire 0 0
  param fuel 14
  param heat 1
  param velocity 0 0.4 0
  param flicker 0.7
node 2 turbulence 1 turbulence 0 96
  param strength 3.5
node 3 pyro_solver 1 solver 250 28
  param buoyancy 0.9
  param vorticity 0.9
  param cooling 1.5
  param smoke_decay 0.15
node 4 volume_look 1 look 490 28
  param smoke_color 0.2 0.19 0.18
  param smoke_density 24
  param fire_light 3
node 5 output 1 output 720 28
link 1.source -> 3.sources
link 2.force -> 3.forces
link 3.gas -> 4.gas
link 4.look -> 5.look
