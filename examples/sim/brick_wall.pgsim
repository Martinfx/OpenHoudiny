pgsim 1
# A wrecking ball through the brick wall of a house. Brick Wall lays the
# wall as a bricklayer lays it -- English bond, a course of headers, a
# course of stretchers, each brick on its bed of mortar with a joint at its
# end, plaster on the inside -- round a window with its frame and a pane of
# glass, on a concrete plinth. The RBD Solver's glue is the mortar, weak --
# 150 kPa -- so the wall breaks along its joints: a hole stepped course by
# course, whole bricks flying and tumbling, some broken in two (Brick
# Wall's Broken: halves held eight times as hard as the mortar holds a
# brick), a chunk still mortared together hanging out of its edge. Rings
# keeps the knock to four rings of bricks round the ball: the window beside
# the hole stays whole, glass and all. The dust of the mortar and the
# broken bricks, the Pyro Solver's, drifts off red-brown. prototype sim
# brick_wall out.mp4 renders it through the camera, a slow push in.
node 1 box 1 wall_left 0 0
  param size 3.38 3 0.265
  param center -0.91 1.7 0
node 20 box 1 wall_right 0 70
  param size 0.52 3 0.265
  param center 2.34 1.7 0
node 21 box 1 wall_below 0 140
  param size 1.3 0.9 0.265
  param center 1.43 0.65 0
node 22 box 1 wall_above 0 210
  param size 1.3 0.9 0.265
  param center 1.43 2.75 0
node 23 merge 1 wall 230 100
node 2 brick_wall 1 bricks 460 100
  param bond english
  param plaster 0.015
  param plastersides back
node 3 primitive_wrangle 1 moving 690 100
  param snippet "// The bricks move. A Merge fills an attribute a geometry lacks with 0 --\n// set on them, active is set on all the pieces.\ni@active = 1;"
node 30 box 1 pane 0 300
  param size 1.14 1.04 0.008
  param center 1.43 1.7 0
node 31 glass_fracture 1 glass 230 300
  param impact 1.2 1.8 0
node 32 primitive_wrangle 1 glass_pieces 460 300
  param snippet "// The pane's shards: numbered past the bricks, and moving.\ni@piece += 200000;\ni@active = 1;"
node 33 box 1 frame_top 0 380
  param size 1.3 0.08 0.1
  param center 1.43 2.26 0
node 34 box 1 frame_bottom 0 450
  param size 1.3 0.08 0.1
  param center 1.43 1.14 0
node 35 box 1 frame_left 0 520
  param size 0.08 1.04 0.1
  param center 0.82 1.7 0
node 36 box 1 frame_right 0 590
  param size 0.08 1.04 0.1
  param center 2.04 1.7 0
node 37 merge 1 frame_parts 230 480
node 38 primitive_wrangle 1 frame 460 480
  param snippet "// The window's frame: a piece of its own, painted white, glued into the\n// opening -- it stays as long as the bricks round it do.\ni@piece = 300000;\ni@active = 1;\nv@Cd = set(0.85, 0.84, 0.8);"
node 4 box 1 plinth 0 680
  param size 5.8 0.2 0.7
  param center 0 0.1 0
node 5 primitive_wrangle 1 foundation 230 680
  param snippet "// The plinth the wall stands on: a piece of its own that does not move --\n// the first course is glued to it.\ni@piece = 100000;\ni@active = 0;\nv@Cd = set(0.36, 0.35, 0.34);"
node 6 merge 1 pieces 920 300
node 7 object 1 ball 690 760
  param size 1.1 1.1 1.1
  param color 0.16 0.16 0.17
  key center 1 smooth -1 4.8 -4.6
  key center 10 smooth -1 2.6 -2.1
  key center 18 smooth -1 1.65 -0.5
  key center 26 smooth -1 1.7 1.3
  key center 40 smooth -1 3.1 3.6
  key center 54 smooth -1 4.7 5.6
node 8 rbd_solver 1 rbd 1150 300
  param density 1800
  param friction 0.7
  param glue 150
  param rings 4
  param substeps 4
  param dust 1.5
  param impact_dust 1.5
  param debris 0.7
  param air 1.2
  param inside_color 0.56 0.36 0.27
node 9 turbulence 1 swirl 1150 480
  param strength 1.2
  param scale 0.8
node 10 pyro_solver 2 dust 1380 380
  param size 10 4.5 10
  param resolution 112
  param buoyancy 0.15
  param weight 0.25
  param vorticity 3
  param smoke_decay 0.2
node 11 volume_look 2 dust_look 1610 380
  param smoke_color 0.66 0.55 0.47
  param smoke_density 9
  param occlusion 1
node 12 output 2 output 1840 300
  param frames 90
  param light_azimuth 145
  param light_elevation 30
  param light_color 1 0.9 0.78
  param light_intensity 2.8
  param sky_intensity 0.45
  param exposure 0.8
  param ground_color 0.13 0.125 0.12
  param grid off
  param sky_behind on
node 13 camera 1 camera 1840 480
  param focal 34
  key center 1 smooth 4.6 1.5 6.4
  key center 90 smooth 3.8 1.4 5.3
  key rotation 1 smooth -2 36 0
  key rotation 90 smooth -2 35 0
