pgsim 1
# A dam breaks: a block of water let go in the corner of a tank runs across
# the floor, round a column, climbs the far wall, falls back and sloshes.
node 1 water_source 1 water 0 0
  param center -0.75 0.4 0
  param size 0.5 0.8 1
node 2 object 1 column 0 96
  param shape cylinder
  param center 0.3 0.25 0.12
  param size 0.16 0.5 0.16
  param color 0.55 0.5 0.45
node 3 liquid_solver 1 solver 250 28
  param size 2 1.2 1
node 4 water_look 1 look 490 28
node 5 output 2 output 720 28
  param frames 120
link 1.water -> 3.sources
link 2.collider -> 3.colliders
link 3.liquid -> 4.liquid
link 4.look -> 5.look
