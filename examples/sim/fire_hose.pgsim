pgsim 1
# A bonfire and a hose: the fire burns for a second and a half, then a jet
# of water from the side plays over it for two seconds. Where the jet goes
# into the flames, part of it boils away before it lands and the rest puts
# the fire out bit by bit; white steam billows up through the dark smoke
# and thins out as it rises.
node 1 pyro_source 2 fire 0 0
  param center 0 0.15 0
  param size 0.45 0.25 0.45
  param fuel 16
  param heat 1.5
  param flicker 0.7
node 2 turbulence 1 turbulence 0 96
  param strength 3.5
node 3 pyro_solver 2 solver 250 28
  param size 2.4 3 2.4
  param buoyancy 0.9
  param vorticity 0.9
  param cooling 1.5
  param smoke_decay 0.15
  param steam 3
  param evaporate 1.5
node 4 volume_look 2 look 490 28
  param smoke_color 0.2 0.19 0.18
  param smoke_density 24
  param steam_density 16
  param fire_light 3
node 5 output 2 output 720 28
node 6 water_source 1 hose 0 300
  param shape sphere
  param center -1.05 0.75 0
  param size 0.07 0.07 0.07
  param mode flow
  param velocity 2.4 1.2 0
  param start 1.5
  param end 3.5
node 7 liquid_solver 1 water 250 300
  param size 2.6 1.6 2
  param resolution 96
  param closed_sides off
node 8 water_look 1 water_look 490 300
node 9 object 1 logs 0 200
  param center 0 0.06 0
  param size 0.6 0.12 0.6
  param color 0.16 0.1 0.06
node 10 camera 1 camera 720 200
  param center 0.25 1.25 3.9
  param rotation 1 3 0
  param focal 30
link 1.source -> 3.sources
link 2.force -> 3.forces
link 3.gas -> 4.gas
link 4.look -> 5.look
link 6.water -> 7.sources
link 7.liquid -> 8.liquid
link 8.look -> 5.look
link 9.collider -> 7.colliders
link 10.camera -> 5.camera
