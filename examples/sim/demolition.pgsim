definition building
| pgsim 1
| asset building 1 "Building"
| help "A building from sliders: Floors high, Width by Depth, its walls cut into bays with a window in each -- framed and set in -- a door in the middle of the front, a roof behind a parapet, and balconies on every Every-th bay of the front and the back."
| promote shell floors floors "Floors"
| promote shell floor_height floor_height "Floor Height"
| promote shell width width "Width"
| promote shell depth depth "Depth"
| promote shell bay bay "Bay"
| promote frames inset frame "Window Frame"
| promote windows distance recess "Window Depth"
| promote balcony_points balconies balconies "Balconies"
| promote balcony_points every every "Every"
| promote paint wall wall "Wall Color"
| node 1 detail_wrangle 1 shell 0 0
|   param snippet "// The shell: four walls, each a grid of cells -- a floor high, a bay\n// wide -- the flat roof and the base. Each cell knows its floor, its\n// column and its wall; the roof and the base have groups of their own.\nint floors = max(chi(\"floors\"), 1);\nfloat fh = max(ch(\"floor_height\"), 0.5);\nfloat w = max(ch(\"width\"), 1);\nfloat d = max(ch(\"depth\"), 1);\nfloat bay = max(ch(\"bay\"), 0.4);\nfloat h = floors * fh;\nvector corners[] = array(set(-w / 2, 0, d / 2), set(w / 2, 0, d / 2), set(w / 2, 0, -d / 2), set(-w / 2, 0, -d / 2));\nvector up = set(0, 1, 0);\nfor (int f = 0; f < 4; f++) {\n    vector a = corners[f];\n    vector b = corners[(f + 1) % 4];\n    int n = max(1, int(rint(length(b - a) / bay)));\n    for (int i = 0; i < floors; i++) {\n        for (int j = 0; j < n; j++) {\n            vector p0 = a + (b - a) * (float(j) / n) + up * (i * fh);\n            vector p1 = a + (b - a) * (float(j + 1) / n) + up * (i * fh);\n            int prim = addprim(0, \"poly\", addpoint(0, p0), addpoint(0, p1), addpoint(0, p1 + up * fh), addpoint(0, p0 + up * fh));\n            setprimattrib(0, \"floor\", prim, i);\n            setprimattrib(0, \"column\", prim, j);\n            setprimattrib(0, \"wall\", prim, f);\n            setprimattrib(0, \"columns\", prim, n);\n        }\n    }\n}\n// The roof and the base: the footprint through every corner of the cells\n// round it, so that they meet the walls edge to edge.\nint top[];\nint bottom[];\nfor (int f = 0; f < 4; f++) {\n    vector a = corners[f];\n    vector b = corners[(f + 1) % 4];\n    int n = max(1, int(rint(length(b - a) / bay)));\n    for (int j = 0; j < n; j++) {\n        vector p = a + (b - a) * (float(j) / n);\n        append(top, addpoint(0, p + up * h));\n        append(bottom, addpoint(0, p));\n    }\n}\nsetprimgroup(0, \"roof\", addprim(0, \"poly\", top), 1);\nint base[];\nfor (int k = len(bottom) - 1; k >= 0; k--) append(base, bottom[k]);  // facing down\nsetprimgroup(0, \"base\", addprim(0, \"poly\", base), 1);"
|   param floors 6
|   param floor_height 0.8
|   param width 3
|   param depth 2.4
|   param bay 0.75
| node 2 fuse 1 weld 0 110
| node 3 primitive_wrangle 1 choose 0 220
|   param snippet "// Which cell is what: the door in the middle of the front wall's ground\n// floor, windows everywhere else on the walls.\nint wallCell = !@group_roof && !@group_base;\nint door = wallCell && @wall == 0 && @floor == 0 && @column == int(@columns / 2);\n@group_door = door;\n@group_window = wallCell && !door;"
| node 4 polyextrude 1 frames 0 330
|   param distance 0
|   param inset 0.15
|   param group "window"
|   param frontgroup "pane"
|   param sidegroup ""
| node 5 polyextrude 1 windows 0 440
|   param distance -0.12
|   param group "pane"
|   param frontgroup "glass"
|   param sidegroup "reveal"
| node 6 polyextrude 1 door 0 550
|   param distance -0.2
|   param inset 0.1
|   param group "door"
|   param frontgroup "doorway"
|   param sidegroup "door_reveal"
| node 7 polyextrude 1 parapet 0 660
|   param distance 0
|   param inset 0.15
|   param group "roof"
|   param frontgroup "roof_inner"
|   param sidegroup "parapet_top"
| node 8 polyextrude 1 roof 0 770
|   param distance -0.3
|   param group "roof_inner"
|   param frontgroup "roof_floor"
|   param sidegroup "parapet_inside"
| node 9 primitive_wrangle 1 paint 0 880
|   param snippet "// The colours: the wall's, its glass, the reveals a shade darker -- and\n// what each is made of, for the renderers (s@material).\nvector wall = chv(\"wall\");\n@Cd = wall;\ns@material = \"plaster\";\nif (@group_glass) {\n    @Cd = set(0.16, 0.22, 0.3);\n    s@material = \"window\";\n}\nif (@group_reveal || @group_door_reveal) @Cd = wall * 0.75;\nif (@group_doorway) {\n    @Cd = set(0.28, 0.18, 0.11);\n    s@material = \"wood\";\n}\nif (@group_roof_floor) {\n    @Cd = set(0.34, 0.34, 0.35);\n    s@material = \"roof\";\n}\nif (@group_parapet_inside) @Cd = wall * 0.85;"
|   param wall 0.78 0.7 0.6
| node 10 detail_wrangle 1 balcony_points 270 330
|   param snippet "// A point at the foot of every Every-th window from the first floor up,\n// on the front and the back, turned out of the wall: where Copy to Points\n// puts a balcony.\nif (chi(\"balconies\")) {\n    int every = max(chi(\"every\"), 1);\n    for (int p = 0; p < nprimitives(1); p++) {\n        if (!inprimgroup(1, \"window\", p)) continue;\n        int fl = prim(1, \"floor\", p);\n        int col = prim(1, \"column\", p);\n        int wl = prim(1, \"wall\", p);\n        if (fl < 1 || (wl != 0 && wl != 2) || col % every != 0) continue;\n        int pts[] = primpoints(1, p);\n        float low = 1e9;\n        for (int k = 0; k < len(pts); k++) low = min(low, point(1, \"P\", pts[k]).y);\n        vector c = primcentroid(1, p);\n        int pt = addpoint(0, set(c.x, low, c.z));\n        setpointattrib(0, \"N\", pt, prim_normal(1, p));\n    }\n}"
|   param balconies 1
|   param every 2
| node 11 box 1 slab 270 220
|   param size 0.6 0.45 0.07
|   param center 0 0.225 0
|   expr size.x "ch(\"../shell/bay\") * 0.8"
| node 12 copy_to_points 1 balconies 510 330
| node 13 color 1 slab_paint 510 440
|   param color 0.42 0.42 0.44
|   param class primitive
| node 14 merge 1 building 270 990
|   display
| link 1.geometry -> 2.geometry
