pgsim 1
# A column of smoke: warm smoke, no fuel, rising and curling in the sun.
# The camera beside the column, its whole height in the picture.
node 1 pyro_source 2 chimney 0 0
  param smoke 5
  param heat 3
  param velocity 0 0.55 0
  param flicker 0.15
node 2 turbulence 1 turbulence 0 96
  param strength 3.5
node 3 pyro_solver 2 solver 250 28
  param weight 0.08
  param vorticity 0.9
  param cooling 0.6
  param smoke_decay 0.03
node 4 volume_look 2 look 490 28
node 5 output 2 output 720 28
node 6 camera 1 camera 720 158
  param center 1.3 0.6 3.3
  param rotation 4.03 21.5 0
  param focal 40
link 1.source -> 3.sources
link 2.force -> 3.forces
link 3.gas -> 4.gas
link 4.look -> 5.look
link 6.camera -> 5.camera
