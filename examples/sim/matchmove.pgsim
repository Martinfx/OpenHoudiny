pgsim 1
# A matchmove shot: the set and the camera come from USD files, in Maya's
# centimetres and Z up (examples/usd, made by make_shot.py) -- a courtyard
# whose crates reference an asset with a variant each, and a camera pushed
# in by hand, 24 frames a second from 1001. A fire burns in the set: its
# smoke rises against the beam, spreads under it and along the back wall.
# Through the camera it goes over the plate -- the courtyard as it was
# filmed (examples/usd/plate, made by make_plate.py): there the walls, the
# beam and the crates are the real ones, catchers as the floor is, which
# hide the smoke behind them and take its shadow and the fire's light.
node 1 usd_import 1 set 0 0
  param file "../usd/shot.usda"
  param prims "/Set/back_wall /Set/side_wall /Set/beam /Set/pillar /Set/crate_a /Set/crate_b"
node 2 object 1 walls 0 110
  param color 0.58 0.55 0.5
  param matte catcher
node 3 pyro_source 2 fire 250 0
  param fuel 14
  param smoke 3
  param heat 1
  param velocity 0 0.4 0
  param flicker 0.7
node 4 turbulence 1 turbulence 250 110
  param strength 3.5
node 5 pyro_solver 2 solver 500 60
  param size 2.6 2.2 2
  param buoyancy 0.9
  param vorticity 0.9
  param cooling 1.5
  param smoke_decay 0.04
node 6 volume_look 2 look 750 60
  param smoke_color 0.2 0.19 0.18
  param smoke_density 24
  param fire_light 3
node 7 usd_camera 1 plate 750 200
  param file "../usd/shot.usda"
  param width 1280
  param plate "../usd/plate/courtyard.####.jpg"
node 8 output 2 output 1000 60
  param frames 72
  param fps 24
link 1.geometry -> 2.shape
link 2.collider -> 5.colliders
link 3.source -> 5.sources
link 4.force -> 5.forces
link 5.gas -> 6.gas
link 6.look -> 8.look
link 7.camera -> 8.camera
