pgsim 1
# Secondary fracture: a concrete beam dropped across a block. The Concrete
# Fracture breaks it into pieces a hand across; the RBD Cluster groups them
# into fourteen chunks, the glue inside a chunk thirty times as strong
# as between chunks. The beam snaps over the block, crushed where it struck;
# its halves fall off and break up into their chunks where they land hard,
# and a chunk breaks into its pieces only where a knock crushes it. The
# broken glue and the knocks puff dust into the Pyro Solver. prototype sim
# concrete_drop out.mp4 renders it through the camera.
node 1 box 1 beam 0 0
  param size 3 0.4 0.4
node 2 concrete_fracture 1 concrete 230 0
  param count 150
  param uneven 0.45
  param chipsize 0.05
  param rough 0.015
  param roughscale 0.25
  param detail 0.035
node 3 rbd_cluster 1 chunks 460 0
  param count 14
  param seed 2
  param strength 30
node 4 transform 1 hanging 690 0
  param t 0 3.4 0
  param r 0 20 6
node 12 primitive_wrangle 1 falling 920 -60
  param snippet "// Dropped from a crane above the frame: it comes in falling already,\n// as fast as three metres of fall make it.\nv@v = set(0, -6, 0);"
node 5 object 1 block 690 130
  param shape box
  param center 0.15 0.55 0
  param size 0.7 1.1 1.1
  param color 0.34 0.33 0.32
node 6 rbd_solver 1 rbd 920 60
  param density 2400
  param friction 0.7
  param glue 1000
  param spread 0.3
  param substeps 4
  param dust 1.2
  param impact_dust 1.5
  param air 1.5
  param color 0.38 0.37 0.355
  param inside_color 0.48 0.46 0.43
node 7 turbulence 1 swirl 920 230
  param strength 1
  param scale 0.6
node 8 pyro_solver 2 dust 1150 140
  param size 7 3.5 7
  param resolution 112
  param buoyancy 0.15
  param weight 0.25
  param vorticity 3
  param smoke_decay 0.3
node 9 volume_look 2 dust_look 1380 140
  param smoke_color 0.66 0.63 0.58
  param smoke_density 10
  param occlusion 1
node 10 output 2 output 1610 60
  param frames 60
  param light_azimuth 145
  param light_elevation 30
  param light_color 1 0.9 0.78
  param light_intensity 2.8
  param sky_intensity 0.45
  param exposure 0.8
  param ground_color 0.13 0.125 0.12
  param grid off
  param sky_behind on
node 11 camera 1 camera 1610 220
  param focal 35
  key center 1 smooth 1.7 1.2 4.1
  key center 60 smooth 1.55 1.1 3.75
  key rotation 1 smooth -6 20 0
  key rotation 60 smooth -6 20 0
link 1.geometry -> 2.geometry
link 2.geometry -> 3.geometry
link 3.geometry -> 4.geometry
link 4.geometry -> 12.geometry
link 12.geometry -> 6.pieces
link 5.collider -> 6.colliders
link 6.dust -> 8.sources
link 6.collider -> 8.colliders
link 5.collider -> 8.colliders
link 7.force -> 8.forces
link 8.gas -> 9.gas
link 6.look -> 10.look
link 9.look -> 10.look
link 11.camera -> 10.camera
