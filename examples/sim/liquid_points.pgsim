pgsim 1
# Water as points: a ball of water falls into a pool. Liquid Points brings the
# particles back as geometry -- each with its velocity v -- and a Point Wrangle
# colours them by how fast they go: deep blue at rest, white in the spray.
# The display flag shows them. The Water Look's Surface is off, so that the
# points are seen; turn it on and the water is drawn over them.
node 1 water_source 1 drop 0 0
  param shape sphere
  param center 0 0.75 0
  param size 0.3 0.3 0.3
node 2 water_source 1 pool 0 96
  param center 0 0.075 0
  param size 1.2 0.15 1.2
node 3 liquid_solver 1 solver 250 28
  param size 1.2 1 1.2
node 4 water_look 1 look 490 28
  param surface off
node 5 output 2 output 720 28
  param frames 90
node 6 liquid_points 1 particles 490 170
node 7 point_wrangle 1 speed_color 720 170
  param snippet "@Cd = vec3(0.05, 0.2, 0.6) + vec3(0.9, 0.75, 0.4) * clamp(length(@v) / 2.5, 0, 1)"
  display
link 1.water -> 3.sources
link 2.water -> 3.sources
link 3.liquid -> 4.liquid
link 3.liquid -> 6.liquid
link 4.look -> 5.look
link 6.geometry -> 7.geometry
