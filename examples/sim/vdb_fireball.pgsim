pgsim 1
# A fireball from an OpenVDB file, as Houdini or EmberGen would hand it
# over (examples/vdb/fireball.vdb, made by make_vdb.py: the explosion
# example 0.6 s in, exported). VDB Gas reads it rather than
# simulating it: its density, temperature and flame on a domain round
# them, which the Volume Look draws as a Pyro Solver's gas -- the fire
# lighting the crates beside it. The same file every frame; a numbered
# sequence (boom.$F4.vdb) plays a file a frame.
node 1 vdb_gas 1 fireball 0 0
  param file "../vdb/fireball.vdb"
node 2 object 1 crate 0 110
  param shape box
  param center 0.85 0.2 0.3
  param rotation 0 25 0
  param size 0.4 0.4 0.4
  param color 0.55 0.4 0.25
node 3 object 1 crate_2 0 220
  param shape box
  param center -0.75 0.15 -0.45
  param rotation 0 -15 0
  param color 0.5 0.36 0.22
node 4 volume_look 2 look 250 0
  param smoke_color 0.16 0.15 0.14
  param smoke_density 22
  param fire_light 3
node 5 output 2 output 490 0
  param frames 24
node 6 camera 1 camera 250 110
  param center 1.9 0.9 2.7
  param rotation -3 35 0
  param focal 30
link 1.gas -> 4.gas
link 4.look -> 5.look
link 6.camera -> 5.camera
