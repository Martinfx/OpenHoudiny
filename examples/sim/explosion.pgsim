pgsim 1
# An explosion: a ball of fuel that burns for a fifth of a second. Burning gas
# swells -- the push of the blast -- then the fireball rises and rolls into a
# cloud of soot.
node 1 sphere_source 1 charge 0 0
  param center 0 0.3 0
  param radius 0.18
  param fuel 50
  param heat 2
  param velocity 0 0.5 0
  param flicker 0.6
  param flicker_size 0.12
  param end 0.2
node 2 turbulence 1 turbulence 0 96
  param strength 6
  param scale 0.12
  param speed 2
node 3 pyro_solver 1 solver 250 28
  param size 2.4 3 2.4
  param substeps 2
  param buoyancy 0.8
  param vorticity 1
  param burn_rate 12
  param heat_release 3
  param soot_release 1.6
  param expansion 3
  param flame_life 0.15
  param cooling 0.8
  param smoke_decay 0.05
node 4 volume_look 1 look 490 28
  param smoke_color 0.16 0.15 0.14
  param smoke_density 22
  param fire_light 3
node 5 output 1 output 720 28
  param frames 60
link 1.source -> 3.sources
link 2.force -> 3.forces
link 3.gas -> 4.gas
link 4.look -> 5.look
