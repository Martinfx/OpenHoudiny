pgsim 1
# Guided destruction: a concrete chimney felled into a street, between the
# houses on either side of it, as the shot wants it. A felling charge blows
# a notch out of its foot at 0.4 s. The Transform fall -- the pieces turned
# about the edge of the notch (Pivot), keyed every four frames as a rod
# topples, with a turn of 8 degrees across the street at the end -- is
# linked into the RBD Solver's Guide: the chimney follows it down, still
# knocking into what is in its way. Where it lands its glue breaks, and what
# breaks off goes its own way (Let Go When Broken), as does what the road
# stops further than Reach from the guide. Key the Transform otherwise --
# later, slower, more turn -- and the chimney falls so. The houses are
# Building assets, with an Object inside each for the pieces and the dust
# to knock into; the road and the kerbs are Objects too.
# prototype sim guided_fall out.mp4 renders it through the camera.
node 1 box 1 chimney 0 0
  param size 1.4 14 1.4
  param center 0 7.4 0
node 2 concrete_fracture 1 concrete 230 0
  param count 170
  param impact 0 0.9 0.5
  param focus 0.5
  param detail 0.08
node 3 primitive_wrangle 1 charge 460 0
  param snippet "// The chimney's pieces move, glued: a Merge fills an attribute a geometry\n// lacks with 0, and the plinth has glue 0 -- so they say it too.\ni@active = 1;\nf@glue = 1;\nv@Cd = set(0.72, 0.7, 0.66);\n// The felling charge at 0.4 s: the foot comes loose from the plinth, and on\n// the side it is to fall to the notch is blown out -- thrown out that way.\nif (@P.y < 1.3) {\n    f@release = 0.4 + 0.02 * rand(i@piece);\n    i@vanish = @P.z > 0.05 && rand(i@piece + 3) < 0.8;\n    v@kick = set(0, 0.5, 2) * (0.5 + rand(i@piece + 9));\n}"
node 4 box 1 plinth 0 150
  param size 3 0.4 3
  param center 0 0.2 0
node 5 primitive_wrangle 1 foundation 230 150
  param snippet "// The plinth the chimney stands on: a piece of its own that does not\n// move, and is not glued to it -- the guide holds the chimney up.\ni@piece = 1000;\ni@active = 0;\nf@glue = 0;\nv@Cd = set(0.46, 0.45, 0.43);"
node 6 merge 1 pieces 690 60
node 7 transform 1 fall 690 -90
  param p 0 0.4 0.7
  key r 12 linear 0 0 0
  key r 16 linear 2.8 0 0
  key r 20 linear 5.2 0 0
  key r 24 linear 7.6 0 0
  key r 28 linear 10.2 0 0
  key r 32 linear 13 0 0
  key r 36 linear 16 0.1 0
  key r 40 linear 19.3 0.45 0
  key r 44 linear 22.9 0.84 0
  key r 48 linear 26.9 1.27 0
  key r 52 linear 31.4 1.75 0
  key r 56 linear 36.5 2.29 0
  key r 60 linear 42.2 2.9 0
  key r 64 linear 48.5 3.58 0
  key r 68 linear 55.7 4.34 0
  key r 72 linear 63.7 5.2 0
  key r 76 linear 72.7 6.15 0
  key r 80 linear 82.6 7.21 0
  key r 84 linear 93.6 8 0
  key r 88 linear 95 8 0
node 8 rbd_solver 1 rbd 920 60
  param density 2400
  param friction 0.7
  param glue 400
  param spread 0.3
  param guide_reach 1.5
  param substeps 4
  param dust 1.5
  param impact_dust 2.5
  param debris 1.5
  param trail 1.2
  param air 1.5
  param inside_color 0.7 0.68 0.63
node 9 building 1 left 0 330
  param floors 2
  param floor_height 3.2
  param width 8
  param depth 7
  param bay 2.4
  param frame 0.7
  param recess -0.18
  param balconies 0
  param wall 0.66 0.54 0.42
node 10 transform 1 at_left 230 330
  param t -7.5 0 11
  param r 0 90 0
node 11 building 1 right 0 440
  param floors 2
  param floor_height 3.2
  param width 8
  param depth 7
  param bay 2.4
  param frame 0.7
  param recess -0.18
  param balconies 0
  param wall 0.5 0.56 0.6
node 12 transform 1 at_right 230 440
  param t 7.5 0 11
  param r 0 -90 0
node 13 building 1 left_far 0 550
  param floors 2
  param floor_height 3.2
  param width 8
  param depth 7
  param bay 2.4
  param frame 0.7
  param recess -0.18
  param balconies 0
  param wall 0.72 0.58 0.34
node 14 transform 1 at_left_far 230 550
  param t -7.5 0 20.5
  param r 0 90 0
node 15 building 1 right_far 0 660
  param floors 2
  param floor_height 3.2
  param width 8
  param depth 7
  param bay 2.4
  param frame 0.7
  param recess -0.18
  param balconies 0
  param wall 0.66 0.46 0.42
node 16 transform 1 at_right_far 230 660
  param t 7.5 0 20.5
  param r 0 -90 0
node 17 merge 1 street 460 500
  display
node 18 object 1 in_left 690 330
  param shape box
  param center -7.5 3.15 11
  param size 6.7 6.3 7.7
  param color 0.5 0.5 0.5
node 19 object 1 in_right 690 440
  param shape box
  param center 7.5 3.15 11
  param size 6.7 6.3 7.7
  param color 0.5 0.5 0.5
node 20 object 1 in_left_far 690 550
  param shape box
  param center -7.5 3.15 20.5
  param size 6.7 6.3 7.7
  param color 0.5 0.5 0.5
node 21 object 1 in_right_far 690 660
  param shape box
  param center 7.5 3.15 20.5
  param size 6.7 6.3 7.7
  param color 0.5 0.5 0.5
node 22 object 1 road 690 770
  param shape box
  param center 0 0.01 16
  param size 5 0.02 42
  param color 0.15 0.15 0.16
node 23 object 1 kerb_left 690 880
  param shape box
  param center -3.25 0.06 16
