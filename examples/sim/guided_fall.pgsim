node 24 object 1 kerb_right 690 990
  param shape box
  param center 3.25 0.06 16
  param size 1.5 0.12 42
  param color 0.52 0.51 0.49
node 25 turbulence 1 swirl 920 260
  param strength 1
  param scale 1.2
node 26 pyro_solver 2 dust 1150 200
  param size 18 10 40
  param resolution 160
  param buoyancy 0.15
  param weight 0.25
  param vorticity 3
  param smoke_decay 0.25
node 27 volume_look 2 dust_look 1380 200
  param smoke_color 0.7 0.68 0.64
  param smoke_density 8
  param occlusion 1
node 28 output 2 output 1610 60
  param frames 130
  param light_azimuth 215
  param light_elevation 55
  param light_color 1 0.9 0.78
  param light_intensity 2.4
  param sky_intensity 0.45
  param exposure 0.8
  param ground_color 0.2 0.2 0.18
  param grid off
  param sky_behind on
node 29 camera 1 camera 1610 240
  param focal 26
  key center 1 smooth 7 13 -17
  key center 130 smooth 5.5 10.5 -12
  key rotation 1 smooth -17.8 164.4 0
  key rotation 130 smooth -23.31 166.61 0
