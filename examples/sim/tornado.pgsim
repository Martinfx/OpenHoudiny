pgsim 1
# A tornado of smoke: a vortex draws the smoke from the floor in towards its
# axis and lifts it, turning.
# The camera low, looking up the whole height of the vortex.
node 1 pyro_source 2 ground 0 0
  param shape box
  param center 0 0.04 0
  param size 0.5 0.06 0.5
  param smoke 5
  param heat 1
  param velocity 0 0.2 0
  param flicker 0.4
  param flicker_size 0.1
node 2 vortex 1 vortex 0 96
  param center 0 1 0
  param radius 0.4
  param speed 2
  param lift 0.7
  param suction 0.35
node 3 turbulence 1 turbulence 0 192
  param strength 2
  param mask everywhere
node 4 pyro_solver 2 solver 250 76
  param size 1.2 2 1.2
  param weight 0.02
  param vorticity 1
  param cooling 0.5
  param smoke_decay 0.05
node 5 volume_look 2 look 490 76
  param smoke_color 0.7 0.68 0.64
  param smoke_density 14
node 6 output 2 output 720 76
  param frames 180
node 7 camera 1 camera 720 206
  param center 1 0.5 3
  param rotation 8.1 18.43 0
  param focal 32
link 1.source -> 4.sources
link 2.force -> 4.forces
link 3.force -> 4.forces
link 4.gas -> 5.gas
link 5.look -> 6.look
link 7.camera -> 6.camera
