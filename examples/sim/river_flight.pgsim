  param output instances
  param variants 4
node 10 grid 1 river 250 0
  param sizex 24
  param sizez 680
  param rows 340
  param cols 2
  param center 0 1 -190
node 11 point_wrangle 1 water 250 110
  param snippet "// Along the river's line, as the valley's wrangle has it; the colour of\n// deep water under the sky.\n@P.x += 18.0 * sin(@P.z * 0.012) + 8.0 * sin(@P.z * 0.031 + 1.0);\n@Cd = set(0.06, 0.13, 0.15);"
node 13 merge 1 landscape 0 600
  display
node 14 camera 1 camera 500 450
