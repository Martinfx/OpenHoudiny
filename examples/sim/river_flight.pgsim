  key center 160 smooth 0 22 -260
  key center 240 smooth 2 70 -400
  key rotation 1 smooth -8 0 0
  key rotation 80 smooth -6 12 0
  key rotation 160 smooth -2 -4 0
  key rotation 240 smooth 5 0 0
node 15 output 2 output 500 300
  param frames 240
  param light_azimuth 150
