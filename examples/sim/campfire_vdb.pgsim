pgsim 1
# The campfire, out to OpenVDB -- for Houdini, Blender, the renderers. Gas
# Volume brings the gas back as three volumes: density (smoke), temperature
# and flame. A file a frame:
# The camera low beside the fire, as the campfire's.
#   prototype sim campfire_vdb - --export-node volumes --export 'out/fire.$F4.vdb'
# In the editor: a right click on volumes, Export Geometry Frames. Simulated
# once to disk (--cache DIR; Simulation > Save Cache to Disk), the frames are
# rendered and exported again without simulating (--from-cache DIR).
node 1 pyro_source 2 fire 0 0
  param fuel 14
  param heat 1
  param velocity 0 0.4 0
  param flicker 0.7
node 2 turbulence 1 turbulence 0 96
  param strength 3.5
node 3 pyro_solver 2 solver 250 28
  param buoyancy 0.9
  param vorticity 0.9
  param cooling 1.5
  param smoke_decay 0.15
node 4 volume_look 2 look 490 28
  param smoke_color 0.2 0.19 0.18
  param smoke_density 24
  param fire_light 3
node 5 output 2 output 720 28
node 6 gas_volume 1 volumes 490 170
node 7 camera 1 camera 720 158
  param center 1.1 0.5 2.6
  param rotation 3.04 22.93 0
  param focal 40
link 1.source -> 3.sources
link 2.force -> 3.forces
link 3.gas -> 4.gas
link 4.look -> 5.look
link 3.gas -> 6.gas
link 7.camera -> 5.camera
