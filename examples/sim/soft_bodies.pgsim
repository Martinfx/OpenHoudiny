link 16.collider -> 14.colliders
link 17.collider -> 14.colliders
link 18.collider -> 14.colliders
link 19.collider -> 14.colliders
link 20.collider -> 14.colliders
link 14.look -> 21.look
link 22.camera -> 21.camera
