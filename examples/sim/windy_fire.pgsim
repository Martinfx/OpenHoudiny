pgsim 1
# A fire in gusty wind: the flames lean over and the smoke streams away.
node 1 box_source 1 logs 0 0
  param center -0.45 0.06 0
  param size 0.3 0.08 0.2
  param fuel 16
  param heat 1
  param velocity 0 0.3 0
  param flicker 0.8
node 2 wind 1 wind 0 330
  param speed 0.9
  param strength 1.2
  param gusts 0.6
node 3 turbulence 1 turbulence 0 520
  param strength 4
node 4 pyro_solver 1 solver 300 120
  param size 2.2 1.4 1
  param buoyancy 0.9
  param vorticity 0.9
  param cooling 1.5
  param smoke_decay 0.1
node 5 volume_look 1 look 560 120
  param smoke_color 0.24 0.23 0.22
  param smoke_density 16
  param fire_light 3
node 6 output 1 output 800 120
link 1.source -> 4.sources
link 2.force -> 4.forces
link 3.force -> 4.forces
link 4.gas -> 5.gas
link 5.look -> 6.look
