pgsim 1
# A ground smoke plume rolling at the camera, as a stock element of one
# shows it: a burst of dense, heavy smoke at ground level -- a cluster of
# puffs, for less than half a second, thrown at the camera, cold -- swells
# into a heap of round billows, wider than it is high, spreads along the
# ground and rolls on until it fills the frame. Each puff is a point
# scattered over a Grid, as big as its pscale -- the shape of the main
# source -- and two jets beside it; the swelling of each puff makes its own
# billow, the flow between them the rest. No noise force: it made the smoke
# boil in streaks. A Pyro Upres three times as fine adds the curls. The smoke
# weighs more than the air and barely lifts: it hugs the ground as it comes,
# a breeze along the ground carrying it on. The sun from behind the camera,
# a dark ground without its grid. The camera stands low in the gas's box, so
# the plume swallows it at the end: 2.7 s.
# Made to look real (docs/pathtracer.md): a short, fast burst slowed by the
# air (Drag) rolls over itself; rendered through Cycles with 16 bounces the
# smoke is lit from within; a little depth of field and film grain take the
# clean look of a render away.
#   prototype --example smoke_plume                     the viewport: Play
#   prototype sim smoke_plume out/plume.mp4             a video of it
#   prototype sim smoke_plume out/plume.mov --renderer cycles   the real look
node 1 pyro_source 2 burst 0 0
  param center 0 0.25 -2.4
  param size 2.4 0.35 1.2
  param smoke 22
  param heat 0.3
  param velocity 0 3.6 10
  param expansion 6
  param flicker 1
  param flicker_size 0.55
  param end 0.3
node 8 pyro_source 2 burst_left 0 96
  param center -0.8 0.2 -2.2
  param size 0.9 0.3 0.9
  param smoke 20
  param heat 0.2
  param velocity -3.2 2 7.5
  param flicker 1
  param flicker_size 0.45
  param start 0.03
  param end 0.27
node 9 pyro_source 2 burst_right 0 192
  param center 0.8 0.2 -2.3
  param size 0.9 0.3 0.9
  param smoke 20
  param heat 0.2
  param velocity 3.2 2.2 7
  param flicker 1
  param flicker_size 0.45
  param start 0.05
  param end 0.29
node 7 wind 1 rolling 0 492
  param direction 0 0 1
  param speed 2.2
  param strength 0.8
node 12 drag 1 drag 0 588
node 20 grid 1 ground -300 0
  param sizez 1
  param center 0 0.2 -2.4
node 21 scatter 1 puffs -300 110
  param count 26
  param seed 9
node 22 point_wrangle 1 sizes -300 220
  param snippet "@pscale = 0.12 + 0.18 * rand(@ptnum * 1.7 + 0.3);\n@P.y += 0.25 * rand(@ptnum * 2.9 + 1.1);"
node 3 pyro_solver 2 solver 250 200
  param size 8 3 8
  param resolution 192
  param substeps 2
  param buoyancy 0.1
  param weight 0.6
  param vorticity 5
  param cooling 1.5
  param smoke_decay 0.015
node 11 pyro_upres 1 upres 490 200
  param scale 3
  param turbulence 2.5
  param swirl_size 3
node 4 volume_look 2 look 730 200
  param smoke_color 0.62 0.61 0.6
  param smoke_density 50
node 5 camera 1 camera 970 330
  param center 0 0.6 3.6
  param rotation 3 0 0
  param focal 24
node 6 output 2 output 970 200
  param frames 81
  param light_azimuth 20
  param light_elevation 28
  param light_intensity 1.3
  param sky_color 0.3 0.33 0.38
  param sky_intensity 0.45
  param ground_color 0.06 0.06 0.065
  param grid off
  param render_bounces 16
  param render_fstop 2.8
  param render_focus 6
  param render_grain 0.3
  param render_motion_blur 0.1
link 1.source -> 3.sources
link 8.source -> 3.sources
link 9.source -> 3.sources
link 7.force -> 3.forces
link 12.force -> 3.forces
link 3.gas -> 11.gas
link 11.gas -> 4.gas
link 4.look -> 6.look
link 5.camera -> 6.camera
link 20.geometry -> 21.geometry
link 21.geometry -> 22.geometry
link 22.geometry -> 1.shape
