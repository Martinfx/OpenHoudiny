node 19 detail_wrangle 1 yard 1150 360
  param snippet "// The yard round the water: paving -- on beyond the walls -- and plastered\n// walls round it where the water's tank has its sides, a coping of concrete\n// on them; the one in front lower, for the camera to look over. Scenery:\n// drawn, not simulated -- the tank holds the water, its sides are these.\nvoid box(vector lo; vector hi; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// A wall along x or z from a to b, from the ground to height h, its coping.\nvoid wall(vector a; vector b; float h) {\n    float c = 0.03;\n    vector wall = chv(\"walls\");\n    vector coping = set(0.46, 0.45, 0.43);\n    box(a, b + set(0, h, 0), wall, \"plaster\");\n    box(a + set(-c, h, -c), b + set(c, h + 0.08, c), coping, \"concrete\");\n}\n\nfloat far = 40;\nfloat t = 0.25;\nfloat h = ch(\"height\");\n// Just under the water's floor: the water closes on it.\nbox(set(-far, -0.1, -far), set(far, -0.002, far), chv(\"paving\"), \"paving\");\nwall(set(-4 - t, 0, -2 - t), set(4 + t, 0, -2), h);\nwall(set(-4 - t, 0, -2), set(-4, 0, 2 + t), h);\nwall(set(4, 0, -2), set(4 + t, 0, 2 + t), h);\nwall(set(-4, 0, 2), set(4, 0, 2 + t), ch(\"front\"));"
  param walls 0.78 0.74 0.66
  param height 2.2
  param paving 0.26 0.25 0.23
  param front 1.5
  display
