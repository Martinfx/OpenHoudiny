pgsim 1
# flood_crates at the resolution of a final shot: the water's grid 512 x 128
# x 256 cells (16.7 million, 1.6 cm a cell), 17.6 million particles -- sparse,
# so that only the tiles round the water are worked on and kept, the air
# above the yard costing nothing. A dam breaks at the end of a walled yard
# and the water sweeps through it: the wooden crates float up, rock on the
# waves and are carried off, the stack toppling; the concrete blocks stay
# where they stand and the water breaks round them. The yard is walled where
# the water's tank has its sides -- plastered walls, the one in front lower
# than the dam, for the camera to look over -- on paving that goes on beyond
# them.
#
# The editor opens it in the preview, its grids a quarter as fine (Output >
# Preview): quick to work on. Simulation > Bake to Disk simulates the whole
# shot at the full resolution in a process of its own, holding 2 GB to 6 GB
# of memory. prototype sim flood_crates_hd out.mp4 --renderer cycles renders it
# through the camera in Cycles; --preview 0.25 first, for a quick look.
node 1 water_source 1 dam 0 0
  param center -3.25 0.7 0
  param size 1.5 1.4 4
node 2 box 1 crate_a 0 140
  param size 0.5 0.5 0.5
  param center 0.2 0.25 -0.9
node 3 box 1 crate_b 0 200
  param size 0.5 0.5 0.5
  param center 0.22 0.77 -0.88
node 4 box 1 crate_c 0 260
  param size 0.5 0.5 0.5
  param center 0.18 1.29 -0.9
node 5 box 1 crate_d 0 320
  param size 0.5 0.5 0.5
  param center 0.5 0.25 0.5
node 6 box 1 crate_e 0 380
  param size 0.6 0.4 0.4
  param center -0.4 0.2 0.9
