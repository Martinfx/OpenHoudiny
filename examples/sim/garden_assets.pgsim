pgsim 1
# Rain on a garden of digital assets: a Spiral Stairs and a Fence, each a
# node of its own with a network inside -- double click one (or I) to go in,
# U to come back up. The Fence follows the Line linked into it: a post on
# each point, rails between. The sliders are what the assets promote; the
# definitions travel with the file, at its end.
node 1 line 1 path 0 0
  param origin -1.3 0 0.95
  param direction 1 0 -0.2
  param length 2.6
  param points 7
node 2 fence 1 fence 230 0
  param height 0.55
  param post_width 0.07
  param rail_size 0.04
node 3 spiral_stairs 1 stairs 0 150
  param steps 11
  param rise 0.09
node 4 object 1 fence_object 460 0
  param color 0.36 0.25 0.16
node 5 object 1 stairs_object 460 150
  param color 0.55 0.52 0.48
node 6 rain 1 rain 700 60
node 7 output 2 output 930 60
  param frames 90
node 8 camera 1 camera 930 250
  param center 2.2 1.3 2.6
  param rotation -14.8 40.2 0
  param focal 30
link 1.geometry -> 2.geometry
link 2.geometry -> 4.shape
link 3.geometry -> 5.shape
link 4.collider -> 6.colliders
link 5.collider -> 6.colliders
link 6.look -> 7.look
link 8.camera -> 7.camera
definition fence
| pgsim 1
| asset fence 1 "Fence"
| help "A fence along a path: a post on each of its points, rails from each point to the next. Link a Line -- or any points, in order -- into it."
| promote rails height height "Height"
| promote rails post_width post_width "Post Width"
| promote rails rails rails "Rails"
| promote rails rail_size rail_size "Rail Size"
| promote paint color color "Color"
| node 1 asset_input 1 path 0 130
| node 2 box 1 post 0 0
|   expr size.x "ch(\"../rails/post_width\")"
|   expr size.y "ch(\"../rails/height\")"
|   expr size.z "ch(\"../rails/post_width\")"
|   expr center.y "ch(\"../rails/height\") / 2"
| node 3 copy_to_points 1 posts 240 30
|   param align off
| node 4 detail_wrangle 1 rails 240 170
|   param snippet "// Rails from each point of the path to the next: a thin box each, at\n// heights up the posts.\nvoid beam(vector a; vector b; float t) {\n    vector d = b - a;\n    float len = length(d);\n    if (len < 1e-6) return;\n    vector x = d / len;\n    vector z = normalize(cross(x, set(0, 1, 0)));\n    vector y = cross(z, x);\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        vector o = (i & 1 ? d : set(0, 0, 0)) + y * ((i & 2 ? 0.5 : -0.5) * t) + z * ((i & 4 ? 0.5 : -0.5) * t);\n        append(p, addpoint(0, a + o));\n    }\n    addprim(0, \"poly\", p[0], p[4], p[6], p[2]);\n    addprim(0, \"poly\", p[1], p[3], p[7], p[5]);\n    addprim(0, \"poly\", p[0], p[1], p[5], p[4]);\n    addprim(0, \"poly\", p[2], p[6], p[7], p[3]);\n    addprim(0, \"poly\", p[0], p[2], p[3], p[1]);\n    addprim(0, \"poly\", p[4], p[5], p[7], p[6]);\n}\n\nfloat height = ch(\"height\");\nint rails = chi(\"rails\");\nfloat t = ch(\"rail_size\");\nfloat half = ch(\"post_width\") * 0.5;\nfor (int i = 0; i + 1 < npoints(1); i++) {\n    vector a = point(1, \"P\", i);\n    vector b = point(1, \"P\", i + 1);\n    vector along = normalize(b - a) * half;  // from a post's face to the next one's\n    for (int r = 0; r < rails; r++) {\n        vector up = set(0, height * 0.9 * (r + 1) / rails, 0);\n        beam(a + along + up, b - along + up, t);\n    }\n}"
|   param height 1
|   param rails 2
|   param rail_size 0.05
|   param post_width 0.08
| node 5 merge 1 fence 470 90
| node 6 color 1 paint 680 90
|   param color 0.45 0.32 0.2
|   display
| link 2.geometry -> 3.geometry
| link 1.geometry -> 3.points
| link 1.geometry -> 4.input1
| link 3.geometry -> 5.geometry
| link 4.geometry -> 5.geometry
| link 5.geometry -> 6.geometry
end
definition spiral_stairs
| pgsim 1
| asset spiral_stairs 1 "Spiral Stairs"
| help "A spiral staircase round a middle: Steps stairs, each Rise higher than the last and turned Turn degrees on, Width wide. Its geometry can be the shape of an object: water runs down it, rain drips off it."
| promote stairs steps steps "Steps"
| promote stairs rise rise "Rise"
| promote stairs turn turn "Turn"
| promote stairs width width "Width"
| promote paint color color "Color"
| node 1 detail_wrangle 1 stairs 0 0
|   param snippet "// A spiral staircase: a box a step, turned round the middle.\nvoid stair(vector c; vector size; float angle) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        vector o = set(i & 1 ? 0.5 : -0.5, i & 2 ? 0.5 : -0.5, i & 4 ? 0.5 : -0.5) * size;\n        append(p, addpoint(0, c + set(o.x * cos(angle) + o.z * sin(angle), o.y, o.z * cos(angle) - o.x * sin(angle))));\n    }\n    addprim(0, \"poly\", p[0], p[4], p[6], p[2]);\n    addprim(0, \"poly\", p[1], p[3], p[7], p[5]);\n    addprim(0, \"poly\", p[0], p[1], p[5], p[4]);\n    addprim(0, \"poly\", p[2], p[6], p[7], p[3]);\n    addprim(0, \"poly\", p[0], p[2], p[3], p[1]);\n    addprim(0, \"poly\", p[4], p[5], p[7], p[6]);\n}\n\nint steps = chi(\"steps\");\nfloat rise = ch(\"rise\");\nfloat width = ch(\"width\");\nfor (int s = 0; s < steps; s++) {\n    float a = radians(ch(\"turn\") * s);\n    float h = rise * (s + 1);  // from the floor up: a solid stair\n    stair(set(cos(a), 0, sin(a)) * (width * 0.5 + 0.2) + set(0, h * 0.5, 0), set(width, h, 0.24), -a);\n}"
|   param steps 12
|   param rise 0.1
|   param width 0.5
|   param turn 25
| node 2 color 1 paint 240 0
|   param color 0.55 0.5 0.45
|   display
| link 1.geometry -> 2.geometry
end
