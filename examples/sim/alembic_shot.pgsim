pgsim 1
# A layout from Blender, as Alembic (examples/abc/shot.abc, made by
# make_shot.py): a corner of a ruin -- two walls, a column, two crates --
# and a camera that dollies in on it, 24 frames a second. Alembic Import
# reads the set where its transforms put it, Y up as Alembic has it; a
# fire burns between the crates, its smoke rising along the back wall.
# Alembic Camera is the shot's camera, frame by frame, its lens as
# Blender's.
node 1 alembic_import 1 set 0 0
  param file "../abc/shot.abc"
  param objects "/back_wall /side_wall /column /crate_a /crate_b"
node 2 object 1 ruin 0 110
  param color 0.6 0.56 0.5
node 3 pyro_source 2 fire 250 0
  param center 0 0.12 -0.15
  param fuel 14
  param smoke 3
  param heat 1
  param velocity 0 0.4 0
  param flicker 0.7
node 4 turbulence 1 turbulence 250 110
  param strength 3.5
node 5 pyro_solver 2 solver 500 60
  param size 3.6 2.2 2.8
  param buoyancy 0.9
  param vorticity 0.9
  param cooling 1.5
  param smoke_decay 0.04
node 6 volume_look 2 look 750 60
  param smoke_color 0.2 0.19 0.18
  param smoke_density 24
  param fire_light 3
node 7 alembic_camera 1 camera 750 200
  param file "../abc/shot.abc"
  param width 1280
node 8 output 2 output 1000 60
  param frames 48
  param fps 24
link 1.geometry -> 2.shape
link 2.collider -> 5.colliders
link 3.source -> 5.sources
link 4.force -> 5.forces
link 5.gas -> 6.gas
link 6.look -> 8.look
link 7.camera -> 8.camera
