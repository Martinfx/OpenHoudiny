node 32 point_wrangle 1 uncanon 1560 550
  param snippet "// The shards put back where the pane was (input 1): what canon did, undone.\nint it = detail(1, \"iteration\");\nvector c = getbbox_center(1);\nvector s = getbbox_size(1);\nvector p = @P - set(rand(it * 3.1 + 0.2) - 0.5, rand(it * 5.3 + 0.7) - 0.5, 0) * 0.3;\nfloat a = -radians(360 * rand(it * 7.13 + 0.5));\np = set(p.x * cos(a) - p.y * sin(a), p.x * sin(a) + p.y * cos(a), p.z);\nif (s.x < s.z) p = set(-p.z, p.y, p.x);\n@P = p + c;"
