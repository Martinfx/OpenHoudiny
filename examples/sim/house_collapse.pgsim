pgsim 1
# A family house collapses into its garden, seen from across the street on a
# summer afternoon. It is built as a house is built: the openings first (a
# point each), the walls round them -- blocks of fired clay laid course by
# course in mortar by Brick Wall, a wall at a time in a For-Each loop,
# plastered outside and in -- in pieces of masonry a few blocks each (RBD
# Cluster), those in chunks glued harder inside; slabs of concrete (Concrete
# Fracture), the gables, a roof of tiles on its rafters that breaks in strips
# (Voronoi Fracture), a brick chimney, gutters and downpipes, windows in white
# frames with their panes (Glass Fracture, a pane at a time in a For-Each
# loop), a door of wood, on a plinth that stays. The walls of the ground
# floor give way, the left side first (charges): their foot bursts to dust,
# the rest comes loose, and what stood on them drops and breaks up where it
# lands, the fence along the street catching what flies out. The dust -- the
# Pyro Solver's -- rolls out over the garden and a breeze takes it off. The
# street round it: a lawn with grass, paving, the road between kerbs, trees,
# shrubs, the neighbours' houses, street lamps. prototype sim house_collapse
# out.png --renderer cycles renders it through the camera in Cycles, the sky
# physical.
node 1 detail_wrangle 1 openings 0 0
  param snippet "// The house's measures, and its openings: a point in the middle of each,\n// halfway through its wall -- N out of the wall, width and height, the wall\n// it is in (wall: 0 and 1 the front's ground and upper floor, 2 3 the\n// back's, 4 5 the left side's, 6 7 the right's) and what it is (kind:\n// window, door). The walls are laid round them, the windows and the door\n// set into them. A window runs from the third bed joint of its floor to\n// the ninth -- sill and head on a course of blocks (Course) -- the door\n// from the floor to the ninth. The measures go on as detail attributes:\n// the nodes that build the house read them from here.\nvoid opening(vector p; vector n; float w; float h; int wall; string kind) {\n    int pt = addpoint(0, p);\n    setpointattrib(0, \"N\", pt, n);\n    setpointattrib(0, \"width\", pt, w);\n    setpointattrib(0, \"height\", pt, h);\n    setpointattrib(0, \"wall\", pt, wall);\n    setpointattrib(0, \"kind\", pt, kind);\n}\n\nfloat width = ch(\"width\");\nfloat depth = ch(\"depth\");\nfloat t = ch(\"thickness\");\nfloat base = ch(\"plinth\");\nfloat storey = ch(\"storey\");\nfloat slab = ch(\"slab\");\nfloat c = ch(\"course\");\nsetdetailattrib(0, \"width\", width);\nsetdetailattrib(0, \"depth\", depth);\nsetdetailattrib(0, \"thickness\", t);\nsetdetailattrib(0, \"plinth\", base);\nsetdetailattrib(0, \"storey\", storey);\nsetdetailattrib(0, \"slab\", slab);\nsetdetailattrib(0, \"pitch\", ch(\"pitch\"));\nfloat zf = depth / 2 - t / 2;\nfloat xs = width / 2 - t / 2;\nfor (int fl = 0; fl < 2; fl++) {\n    float y0 = base + fl * (storey + slab);\n    float sill = y0 + 3 * c;\n    float head = y0 + 9 * c;\n    float mid = (sill + head) / 2;\n    float h = head - sill;\n    // The front: two wide windows, the door between them -- over it,\n    // upstairs, a narrower window.\n    opening(set(-3, mid, zf), set(0, 0, 1), 1.5, h, fl, \"window\");\n    opening(set(3, mid, zf), set(0, 0, 1), 1.5, h, fl, \"window\");\n    if (fl == 0) {\n        opening(set(0, (y0 + head) / 2, zf), set(0, 0, 1), 1.1, head - y0, 0, \"door\");\n    } else {\n        opening(set(0, mid, zf), set(0, 0, 1), 1.2, h, 1, \"window\");\n    }\n    // The back: three windows.\n    for (int k = -1; k <= 1; k++) {\n        opening(set(3 * k, mid, -zf), set(0, 0, -1), 1.2, h, 2 + fl, \"window\");\n    }\n    // The sides: a window into the front room, another into the back one.\n    for (int s = 0; s < 2; s++) {\n        float x = s == 0 ? -xs : xs;\n        vector n = set(s == 0 ? -1 : 1, 0, 0);\n        opening(set(x, mid, 1.7), n, 1.2, h, 4 + 2 * s + fl, \"window\");\n        opening(set(x, mid, -2.2), n, 1.2, h, 4 + 2 * s + fl, \"window\");\n    }\n}"
  param width 10
  param depth 8
  param thickness 0.3
  param plinth 0.45
  param storey 2.75
  param slab 0.25
  param course 0.25
  param pitch 40
node 2 detail_wrangle 1 walls 0 110
  param snippet "// The walls, floor by floor: each a solid of boxes round its openings (the\n// points of input 1) -- touching face to face, as Brick Wall takes them --\n// its number in wall, as the openings have it. The front and the back run\n// the house's whole width, the sides between them; inside, a wall down the\n// middle of each floor (8, 9: the group inner), a doorway through it.\n\nvoid box(vector lo; vector hi; int w) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));  // -x\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));  // +x\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));  // -y\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));  // +y\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));  // -z\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));  // +z\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"wall\", f[k], w);\n        setprimgroup(0, \"inner\", f[k], w >= 8);\n    }\n}\n\n// A wall from a0 to a1 along x (axis 0) or z (axis 2), c0 to c1 across it,\n// y0 to y1 up, round the openings in holes -- four numbers each: from, to\n// along it, from, to up -- cut into strips where an opening begins or ends.\nvoid wall(int axis; float a0; float a1; float c0; float c1; float y0; float y1; float holes[]; int w) {\n    float cuts[] = array(a0, a1);\n    for (int k = 0; k < len(holes); k += 4) {\n        append(cuts, holes[k]);\n        append(cuts, holes[k + 1]);\n    }\n    cuts = sort(cuts);\n    for (int i = 0; i + 1 < len(cuts); i++) {\n        float s = cuts[i];\n        float e = cuts[i + 1];\n        if (e - s < 0.0001) continue;\n        // The openings across this strip, from the bottom up.\n        float ys[];\n        for (int k = 0; k < len(holes); k += 4) {\n            if (holes[k] <= s + 0.0001 && holes[k + 1] >= e - 0.0001) {\n                append(ys, holes[k + 2]);\n                append(ys, holes[k + 3]);\n            }\n        }\n        ys = sort(ys);\n        float lo = y0;\n        for (int k = 0; k <= len(ys); k += 2) {\n            float top = k < len(ys) ? ys[k] : y1;\n            if (top - lo > 0.0001) {\n                if (axis == 0) box(set(s, lo, c0), set(e, top, c1), w);\n                else box(set(c0, lo, s), set(c1, top, e), w);\n            }\n            if (k < len(ys)) lo = ys[k + 1];\n        }\n    }\n}\n\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat t = detail(1, \"thickness\");\nfloat base = detail(1, \"plinth\");\nfloat storey = detail(1, \"storey\");\nfloat slab = detail(1, \"slab\");\nfor (int w = 0; w < 10; w++) {\n    int fl = w < 8 ? w % 2 : w - 8;\n    int side = int(w / 2);\n    float y0 = base + fl * (storey + slab);\n    float y1 = y0 + storey;\n    float holes[];\n    for (int i = 0; i < npoints(1); i++) {\n        if (point(1, \"wall\", i) != w) continue;\n        vector p = point(1, \"P\", i);\n        vector n = point(1, \"N\", i);\n        float a = abs(n.z) > 0.5 ? p.x : p.z;\n        float hw2 = point(1, \"width\", i) / 2;\n        float hh = point(1, \"height\", i) / 2;\n        append(holes, a - hw2);\n        append(holes, a + hw2);\n        append(holes, p.y - hh);\n        append(holes, p.y + hh);\n    }\n    if (w >= 8) {\n        // The wall down the middle, its doorway: on the left downstairs,\n        // on the right upstairs -- eight courses high.\n        float d = fl == 0 ? -1.8 : 1.8;\n        float mz = ch(\"middle\");\n        append(holes, d - 0.45);\n        append(holes, d + 0.45);\n        append(holes, y0);\n        append(holes, y0 + 2.0);\n        wall(0, -hw + t, hw - t, mz - ch(\"inner_thickness\") / 2, mz + ch(\"inner_thickness\") / 2, y0, y1, holes, w);\n    } else if (side == 0) {\n        wall(0, -hw, hw, hd - t, hd, y0, y1, holes, w);\n    } else if (side == 1) {\n        wall(0, -hw, hw, -hd, -hd + t, y0, y1, holes, w);\n    } else if (side == 2) {\n        wall(2, -hd + t, hd - t, -hw, -hw + t, y0, y1, holes, w);\n    } else {\n        wall(2, -hd + t, hd - t, hw - t, hw, y0, y1, holes, w);\n    }\n}"
  param middle -0.45
  param inner_thickness 0.145
