node 41 detail_wrangle 1 gutters 1800 330
  param snippet "// A box in the frame of an opening: lo to hi along u (the wall), v (up)\n// and n (out of the wall), from o.\nvoid lbox(vector o; vector u; vector v; vector n; vector lo; vector hi; int piece; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        vector l = set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z);\n        append(p, addpoint(0, o + u * l.x + v * l.y + n * l.z));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"piece\", f[k], piece);\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// The gutters along the eaves -- hung on the fascia, in lengths -- and the\n// downpipes from them down the front corners of the house: sheet metal,\n// anthracite.\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat yp = detail(1, \"plinth\") + 2 * (detail(1, \"storey\") + detail(1, \"slab\"));\nfloat a = radians(detail(1, \"pitch\"));\nfloat ov = ch(\"eaves\");\nfloat x = hw + ch(\"verge\");\nfloat yo = yp - ov * tan(a);\nvector c = chv(\"color\");\nvector o = set(0, 0, 0);\nvector X = set(1, 0, 0);\nvector Y = set(0, 1, 0);\nvector Z = set(0, 0, 1);\nint piece = 5100000;\nfor (int s = -1; s <= 1; s += 2) {\n    float z0 = s * (hd + ov);\n    float z1 = z0 + s * 0.12;\n    for (int k = 0; k < 3; k++) {\n        float x0 = -x + k * 2 * x / 3;\n        float x1 = x0 + 2 * x / 3;\n        lbox(o, X, Y, Z, set(x0, yo - 0.05, min(z0, z1)), set(x1, yo + 0.07, max(z0, z1)), piece, c, \"metal\");\n        piece++;\n    }\n}\nfor (int s = -1; s <= 1; s += 2) {\n    float px = s * (hw - 0.3);\n    float top = yo - 0.05 - 0.08;\n    for (int k = 0; k < 3; k++) {\n        lbox(o, X, Y, Z, set(px - 0.05, k * top / 3, hd), set(px + 0.05, (k + 1) * top / 3, hd + 0.1), piece, c, \"metal\");\n        piece++;\n    }\n    lbox(o, X, Y, Z, set(px - 0.05, top, hd), set(px + 0.05, yo - 0.05, hd + ov + 0.06), piece, c, \"metal\");\n    piece++;\n}"
  param color 0.12 0.12 0.13
  expr eaves "ch(\"../roof/eaves\")"
  expr verge "ch(\"../roof/verge\")"
node 42 primitive_wrangle 1 gutter_pieces 1800 440
