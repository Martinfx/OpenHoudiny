node 35 detail_wrangle 1 plinth 1800 110
  param snippet "// The plinth the house stands on -- its foundations, a piece that does not\n// move -- its top the floor of the ground floor; two steps up to the door.\nvoid box(vector lo; vector hi) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    addprim(0, \"poly\", p[0], p[4], p[6], p[2]);\n    addprim(0, \"poly\", p[1], p[3], p[7], p[5]);\n    addprim(0, \"poly\", p[0], p[1], p[5], p[4]);\n    addprim(0, \"poly\", p[2], p[6], p[7], p[3]);\n    addprim(0, \"poly\", p[0], p[2], p[3], p[1]);\n    addprim(0, \"poly\", p[4], p[5], p[7], p[6]);\n}\n\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat base = detail(1, \"plinth\");\nbox(set(-hw, 0, -hd), set(hw, base, hd));\nbox(set(-0.9, 0, hd), set(0.9, base * 2 / 3, hd + 0.35));\nbox(set(-0.9, 0, hd + 0.35), set(0.9, base / 3, hd + 0.7));"
