node 26 detail_wrangle 1 windows 1320 110
  param snippet "// A box in the frame of an opening: lo to hi along u (the wall), v (up)\n// and n (out of the wall), from o.\nvoid lbox(vector o; vector u; vector v; vector n; vector lo; vector hi; int piece; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        vector l = set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z);\n        append(p, addpoint(0, o + u * l.x + v * l.y + n * l.z));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"piece\", f[k], piece);\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// The windows and the door, set into their openings (the points of input\n// 1): round each window a frame, and a mullion down the middle of a wide\n// one -- white, a piece a window -- set back Reveal from the face of the\n// wall; under it a sill of sheet metal out over the wall. The door, of\n// wood, in a frame of wood. The panes are the node panes'.\nfloat t2 = detail(1, \"thickness\") / 2;\nfloat back = ch(\"reveal\");\nfloat fw = ch(\"frame\");\nfloat fd = ch(\"frame_depth\");\nvector white = chv(\"color\");\nfor (int i = 0; i < npoints(1); i++) {\n    vector o = point(1, \"P\", i);\n    vector n = point(1, \"N\", i);\n    vector v = set(0, 1, 0);\n    vector u = cross(v, n);\n    float w = point(1, \"width\", i) / 2;\n    float h = point(1, \"height\", i) / 2;\n    int piece = 6000000 + 10 * i;\n    float s1 = t2 - back;\n    float s0 = s1 - fd;\n    if (point(1, \"kind\", i) == \"door\") {\n        vector wood = chv(\"door\");\n        lbox(o, u, v, n, set(-w, -h, s0), set(-w + fw, h, s1), piece, wood, \"wood\");\n        lbox(o, u, v, n, set(w - fw, -h, s0), set(w, h, s1), piece, wood, \"wood\");\n        lbox(o, u, v, n, set(-w + fw, h - fw, s0), set(w - fw, h, s1), piece, wood, \"wood\");\n        lbox(o, u, v, n, set(-w + fw, -h, s0 + 0.02), set(w - fw, h - fw, s0 + 0.07), piece + 1, wood * 0.8, \"wood\");\n        continue;\n    }\n    lbox(o, u, v, n, set(-w, h - fw, s0), set(w, h, s1), piece, white, \"none\");\n    lbox(o, u, v, n, set(-w, -h, s0), set(w, -h + fw, s1), piece, white, \"none\");\n    lbox(o, u, v, n, set(-w, -h + fw, s0), set(-w + fw, h - fw, s1), piece, white, \"none\");\n    lbox(o, u, v, n, set(w - fw, -h + fw, s0), set(w, h - fw, s1), piece, white, \"none\");\n    if (w > 0.5) lbox(o, u, v, n, set(-0.06, -h + fw, s0), set(0.06, h - fw, s1), piece, white, \"none\");\n    lbox(o, u, v, n, set(-w, -h, s1), set(w, -h + 0.03, t2 + 0.05), piece + 1, chv(\"sill\"), \"metal\");\n}"
  param reveal 0.1
  param frame 0.08
  param frame_depth 0.08
  param color 0.86 0.86 0.84
  param door 0.2 0.11 0.06
  param sill 0.32 0.32 0.33
