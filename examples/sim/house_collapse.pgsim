node 52 detail_wrangle 1 ground 2040 110
  param snippet "void box(vector lo; vector hi; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// The ground round the house: a lawn out to the neighbours and beyond, the\n// street in front -- asphalt between two kerbs, a pavement of paving\n// either side -- a path of paving from the door to the gate and a drive\n// along the right side of the house.\nfloat far = 120;\nbox(set(-far, -0.05, -far), set(far, 0.004, far), chv(\"lawn\"), \"lawn\");\nbox(set(-far, -0.05, 11.55), set(far, 0.02, 17.45), chv(\"asphalt\"), \"asphalt\");\nbox(set(-far, -0.05, 9.6), set(far, 0.1, 11.4), chv(\"paving\"), \"paving\");\nbox(set(-far, -0.05, 17.6), set(far, 0.1, 19.6), chv(\"paving\"), \"paving\");\nbox(set(-far, -0.05, 11.4), set(far, 0.14, 11.55), set(0.42, 0.41, 0.39), \"concrete\");\nbox(set(-far, -0.05, 17.45), set(far, 0.14, 17.6), set(0.42, 0.41, 0.39), \"concrete\");\nbox(set(-0.7, -0.05, 4.7), set(0.7, 0.03, 9.6), chv(\"paving\") * 1.15, \"paving\");\nbox(set(6.0, -0.05, -2.0), set(9.0, 0.03, 9.6), chv(\"paving\"), \"paving\");"
  param lawn 0.1 0.17 0.045
  param asphalt 0.06 0.06 0.065
  param paving 0.22 0.21 0.2
node 53 detail_wrangle 1 fence 2040 220
  param snippet "void box(vector lo; vector hi; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// The wooden fence down the sides of the garden: posts, two rails, pickets\n// a hand apart. Along the street it is the node front_fence's.\nvoid run(vector a; vector b; vector color) {\n    vector d = b - a;\n    float len = length(d);\n    vector x = d / len;\n    vector side = set(-x.z, 0, x.x);\n    int posts = int(ceil(len / 2.4));\n    for (int i = 0; i <= posts; i++) {\n        vector p = a + d * (i / posts);\n        box(p - set(0.05, 0, 0.05), p + set(0.05, 1.2, 0.05), color * 0.8, \"wood\");\n    }\n    for (int r = 0; r < 2; r++) {\n        float y = r == 0 ? 0.25 : 0.85;\n        vector lo = a + side * 0.05 + set(0, y, 0);\n        vector hi = b + side * 0.09 + set(0, y + 0.07, 0);\n        box(set(min(lo.x, hi.x), lo.y, min(lo.z, hi.z)), set(max(lo.x, hi.x), hi.y, max(lo.z, hi.z)), color * 0.9, \"wood\");\n    }\n    int n = int(len / 0.14);\n    for (int i = 0; i < n; i++) {\n        vector p = a + x * ((i + 0.5) * len / n) + side * 0.1;\n        float h = 1.05 + 0.03 * (rand(i * 1.3 + a.x) - 0.5);\n        vector lo = p - x * 0.045;\n        vector hi = p + x * 0.045 + side * 0.022 + set(0, h, 0);\n        box(set(min(lo.x, hi.x), 0, min(lo.z, hi.z)), set(max(lo.x, hi.x), hi.y, max(lo.z, hi.z)),\n            color * (0.85 + 0.3 * rand(i * 7.1 + a.z)), \"wood\");\n    }\n}\n\nvector c = chv(\"color\");\nrun(set(-16, 0, -18), set(-16, 0, 9.4), c);\nrun(set(16, 0, 9.4), set(16, 0, -18), c);"
  param color 0.33 0.21 0.12
node 54 detail_wrangle 1 neighbours 2040 330
  param snippet "void box(vector lo; vector hi; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// The neighbours' houses, as the house was before: walls of plaster on a\n// darker plinth, windows with rooms behind them in white frames, a door, a\n// roof of tiles over the gables with a chimney -- standing still, set apart\n// by Center, turned by Turn (0: facing the street), their own colours.\nvoid face(vector o; vector u; vector v; float w; float h; vector color; string material) {\n    int a = addpoint(0, o - u * w - v * h);\n    int b = addpoint(0, o + u * w - v * h);\n    int c = addpoint(0, o + u * w + v * h);\n    int d = addpoint(0, o - u * w + v * h);\n    int f = addprim(0, \"poly\", a, b, c, d);\n    setprimattrib(0, \"Cd\", f, color);\n    setprimattrib(0, \"material\", f, material);\n}\n\nvoid tri(vector a; vector b; vector c; vector color; string material) {\n    int f = addprim(0, \"poly\", addpoint(0, a), addpoint(0, b), addpoint(0, c));\n    setprimattrib(0, \"Cd\", f, color);\n    setprimattrib(0, \"material\", f, material);\n}\n\nvoid quad(vector a; vector b; vector c; vector d; vector color; string material) {\n    int f = addprim(0, \"poly\", addpoint(0, a), addpoint(0, b), addpoint(0, c), addpoint(0, d));\n    setprimattrib(0, \"Cd\", f, color);\n    setprimattrib(0, \"material\", f, material);\n}\n\nvoid house(vector at; float w; float d; float eave; float pitch; vector wall; vector roof) {\n    float hw = w / 2;\n    float hd = d / 2;\n    box(at + set(-hw, 0, -hd), at + set(hw, 0.5, hd), wall * 0.4, \"plaster\");\n    box(at + set(-hw, 0.5, -hd), at + set(hw, eave, hd), wall, \"plaster\");\n    // The gables, and the roof over them.\n    float ridge = eave + hd * tan(radians(pitch));\n    for (int s = -1; s <= 1; s += 2) {\n        tri(at + set(s * hw, eave, -hd), at + set(s * hw, eave, hd), at + set(s * hw, ridge, 0), wall, \"plaster\");\n    }\n    float ov = 0.5;\n    float x = hw + 0.4;\n    float yo = eave - ov * tan(radians(pitch));\n    float th = 0.25;\n    for (int s = -1; s <= 1; s += 2) {\n        vector e0 = at + set(-x, yo, s * (hd + ov));\n        vector e1 = at + set(x, yo, s * (hd + ov));\n        vector r0 = at + set(-x, ridge, 0);\n        vector r1 = at + set(x, ridge, 0);\n        vector up = set(0, th, 0);\n        if (s > 0) {\n            quad(e0 + up, e1 + up, r1 + up, r0 + up, roof, \"roof_tiles\");\n            quad(e0, r0, r1, e1, set(0.4, 0.29, 0.18), \"wood\");\n            quad(e0, e1, e1 + up, e0 + up, set(0.12, 0.08, 0.05), \"wood\");\n        } else {\n            quad(e1 + up, e0 + up, r0 + up, r1 + up, roof, \"roof_tiles\");\n            quad(e1, r1, r0, e0, set(0.4, 0.29, 0.18), \"wood\");\n            quad(e1, e0, e0 + up, e1 + up, set(0.12, 0.08, 0.05), \"wood\");\n        }\n        quad(e0, e0 + up, r0 + up, r0, set(0.12, 0.08, 0.05), \"wood\");\n        quad(e1, r1, r1 + up, e1 + up, set(0.12, 0.08, 0.05), \"wood\");\n    }\n    box(at + set(hw * 0.4, ridge - 1.0, -1.2), at + set(hw * 0.4 + 0.55, ridge + 0.9, -0.7), set(0.3, 0.13, 0.09), \"brick_wall\");\n    // Windows on each floor, the door in the middle of the front.\n    vector white = set(0.82, 0.82, 0.8);\n    int floors = int((eave - 0.5) / 2.9);\n    for (int fl = 0; fl < floors; fl++) {\n        float y = 0.5 + fl * 3.0 + 1.55;\n        for (int k = -1; k <= 1; k++) {\n            vector o = at + set(k * w / 3.2, y, hd + 0.004);\n            if (fl == 0 && k == 0) {\n                face(o + set(0, -0.45, 0), set(1, 0, 0), set(0, 1, 0), 0.55, 1.15, white, \"none\");\n                face(o + set(0, -0.48, 0.003), set(1, 0, 0), set(0, 1, 0), 0.47, 1.1, set(0.25, 0.14, 0.08), \"wood\");\n                continue;\n            }\n            face(o, set(1, 0, 0), set(0, 1, 0), 0.68, 0.78, white, \"none\");\n            face(o + set(0, 0, 0.003), set(1, 0, 0), set(0, 1, 0), 0.6, 0.7, set(0.5, 0.5, 0.5), \"window\");\n            vector b = at + set(k * w / 3.2, y, -hd - 0.004);\n            face(b, set(-1, 0, 0), set(0, 1, 0), 0.68, 0.78, white, \"none\");\n            face(b - set(0, 0, 0.003), set(-1, 0, 0), set(0, 1, 0), 0.6, 0.7, set(0.5, 0.5, 0.5), \"window\");\n        }\n        for (int s = -1; s <= 1; s += 2) {\n            for (int k = -1; k <= 1; k += 2) {\n                vector o = at + set(s * (hw + 0.004), y, k * d / 4);\n                face(o, set(0, 0, -s), set(0, 1, 0), 0.6, 0.78, white, \"none\");\n                face(o + set(s * 0.003, 0, 0), set(0, 0, -s), set(0, 1, 0), 0.52, 0.7, set(0.5, 0.5, 0.5), \"window\");\n            }\n        }\n    }\n}\n\nhouse(set(-20, 0, 0.5), 9, 8.5, 6.4, 38, chv(\"left_wall\"), chv(\"left_roof\"));\nhouse(set(21, 0, -0.5), 11, 9, 3.6, 42, chv(\"right_wall\"), chv(\"right_roof\"));\nhouse(set(-7, 0, -30), 10, 8, 6.4, 40, set(0.75, 0.74, 0.7), set(0.3, 0.11, 0.07));\nhouse(set(12, 0, -31), 9, 8, 6.4, 40, set(0.62, 0.66, 0.6), set(0.08, 0.085, 0.09));\nhouse(set(-34, 0, -1), 10, 8, 6.4, 38, set(0.74, 0.66, 0.54), set(0.28, 0.1, 0.06));\nhouse(set(36, 0, 0), 9, 8.5, 6.4, 40, set(0.8, 0.79, 0.75), set(0.3, 0.12, 0.07));"
  param left_wall 0.78 0.77 0.72
  param left_roof 0.3 0.1 0.06
  param right_wall 0.8 0.7 0.45
  param right_roof 0.08 0.085 0.09
node 55 detail_wrangle 1 lamps 2040 440
  param snippet "void box(vector lo; vector hi; vector color; string material) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], material);\n    }\n}\n\n// Street lamps along the near pavement: a grey steel pole, an arm and a lamp.\nfor (int i = 0; i < 2; i++) {\n    float x = -14 + i * 29;\n    vector g = set(0.22, 0.23, 0.24);\n    box(set(x - 0.07, 0, 11.0), set(x + 0.07, 6.0, 11.14), g, \"metal\");\n    box(set(x - 0.05, 5.85, 11.14), set(x + 0.05, 5.95, 12.3), g, \"metal\");\n    box(set(x - 0.16, 5.75, 12.2), set(x + 0.16, 5.88, 12.75), g * 0.7, \"metal\");\n}"
node 56 detail_wrangle 1 tree_spots 2280 110
  param snippet "// Where the trees stand: in the gardens -- a big one by the fence on the\n// left, a smaller one on the right, more behind the house -- and the rows\n// of a park behind the houses at the back; pscale how big each is.\nvoid tree(vector p; float s) {\n    int pt = addpoint(0, p);\n    setpointattrib(0, \"pscale\", pt, s);\n}\ntree(set(-10.5, 0, 5.5), 1.25);\ntree(set(12.5, 0, 6.5), 0.85);\ntree(set(-11, 0, -10), 1.1);\ntree(set(10, 0, -12), 1.2);\ntree(set(-2, 0, -15), 1.0);\ntree(set(-27, 0, 8), 1.1);\ntree(set(28, 0, 7), 1.0);\nfor (int i = 0; i < 26; i++) {\n    float x = -60 + i * 4.8 + 2.5 * (rand(i * 3.7) - 0.5);\n    float z = -44 - 8 * rand(i * 5.1 + 0.3);\n    if (abs(x + 7) < 6 || abs(x - 12) < 5) z -= 6;\n    tree(set(x, 0, z), 1.1 + 0.6 * rand(i * 2.9 + 0.1));\n}"
