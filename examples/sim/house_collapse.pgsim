  param snippet "// Shrubs along the fence inside the garden and by the corners of the house.\nvoid shrub(vector p; float s) {\n    int pt = addpoint(0, p);\n    setpointattrib(0, \"pscale\", pt, s);\n}\nfor (int i = 0; i < 22; i++) {\n    float x = -15.2 + i * 0.7 + 0.3 * rand(i);\n    if (x > -1.6 && x < 1.6) continue;\n    if (x > 5.4) break;\n    shrub(set(x, 0, 8.7 + 0.3 * rand(i + 9)), 0.9 + 0.5 * rand(i * 1.7));\n}\nfor (int i = 0; i < 8; i++) {\n    shrub(set(10.0 + i * 0.75, 0, 8.6 + 0.3 * rand(i + 30)), 0.9 + 0.5 * rand(i * 2.3));\n}\nshrub(set(-5.9, 0, 4.4), 1.3);\nshrub(set(-6.6, 0, 3.4), 1.0);\nshrub(set(5.6, 0, 4.6), 0.8);"
