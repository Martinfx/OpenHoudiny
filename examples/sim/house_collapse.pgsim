node 28 detail_wrangle 1 panes 1560 110
  param snippet "// The panes of the windows: one in each half of a wide window, either side\n// of its mullion, one in a narrow one -- set into the middle of the frame's\n// depth, touching it all round. A box each, numbered (pane), for the loop\n// that breaks them one by one.\nfloat t2 = detail(1, \"thickness\") / 2;\nfloat fw = ch(\"frame\");\nfloat s = t2 - ch(\"reveal\") - ch(\"frame_depth\") / 2;\nfloat g = ch(\"thickness\") / 2;\nint pane = 0;\nfor (int i = 0; i < npoints(1); i++) {\n    if (point(1, \"kind\", i) != \"window\") continue;\n    vector o = point(1, \"P\", i);\n    vector n = point(1, \"N\", i);\n    vector v = set(0, 1, 0);\n    vector u = cross(v, n);\n    float w = point(1, \"width\", i) / 2;\n    float h = point(1, \"height\", i) / 2;\n    float left[];\n    float right[];\n    if (w > 0.5) {\n        left = array(-w + fw, 0.06);\n        right = array(-0.06, w - fw);\n    } else {\n        left = array(-w + fw);\n        right = array(w - fw);\n    }\n    for (int k = 0; k < len(left); k++) {\n        vector lo = set(left[k], -h + fw, s - g);\n        vector hi = set(right[k], h - fw, s + g);\n        int p[];\n        for (int j = 0; j < 8; j++) {\n            vector l = set(j & 1 ? hi.x : lo.x, j & 2 ? hi.y : lo.y, j & 4 ? hi.z : lo.z);\n            append(p, addpoint(0, o + u * l.x + v * l.y + n * l.z));\n        }\n        int f[];\n        append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n        append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n        append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n        append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n        append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n        append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n        for (int m = 0; m < 6; m++) setprimattrib(0, \"pane\", f[m], pane);\n        pane++;\n    }\n}"
  param thickness 0.02
  expr frame "ch(\"../windows/frame\")"
  expr reveal "ch(\"../windows/reveal\")"
  expr frame_depth "ch(\"../windows/frame_depth\")"
