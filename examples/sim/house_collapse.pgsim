node 15 primitive_wrangle 1 slab_finish 360 330
  param snippet "// The slabs' pieces numbered on past the walls', and their faces as the\n// house has them: the edges round the outside plastered as the facade, the\n// undersides -- the ceilings -- white, the floors concrete.\ni@piece += 2000000;\ni@kind = 3;\ni@floor = @P.y > detail(1, \"plinth\") + 2 * detail(1, \"storey\") ? 1 : 0;\nif (!@group_inside) {\n    vector n = prim_normal(0, @primnum);\n    if (abs(n.y) < 0.5) {\n        @Cd = chv(\"plaster\");\n        s@material = \"plaster\";\n    } else if (n.y < -0.5) {\n        @Cd = chv(\"inside\");\n        s@material = \"plaster\";\n    }\n}"
  param plaster 0.72 0.6 0.42
  param inside 0.7 0.68 0.64
node 16 detail_wrangle 1 gables 600 110
  param snippet "// A polygon through the points ids -- at ps -- turned to face away from mid.\nvoid facet(int ids[]; vector ps[]; vector mid; int piece; vector color; string material) {\n    vector n = set(0, 0, 0);\n    vector c = set(0, 0, 0);\n    int m = len(ps);\n    for (int i = 0; i < m; i++) {\n        vector a = ps[i];\n        vector b = ps[(i + 1) % m];\n        n += set((a.y - b.y) * (a.z + b.z), (a.z - b.z) * (a.x + b.x), (a.x - b.x) * (a.y + b.y));\n        c += a;\n    }\n    c = c / m;\n    int pts[];\n    if (dot(n, c - mid) >= 0) {\n        for (int i = 0; i < m; i++) append(pts, ids[i]);\n    } else {\n        for (int i = m - 1; i >= 0; i--) append(pts, ids[i]);\n    }\n    int pr = addprim(0, \"poly\", pts);\n    setprimattrib(0, \"piece\", pr, piece);\n    setprimattrib(0, \"Cd\", pr, color);\n    setprimattrib(0, \"material\", pr, material);\n}\n\n// A prism: the outline zy -- corners in z and y, in order round it -- from\n// x0 to x1, closed, its corners shared by its faces.\nvoid prism(vector zy[]; float x0; float x1; int piece; vector color; string material) {\n    int m = len(zy);\n    vector mid = set(0, 0, 0);\n    vector pa[];\n    vector pb[];\n    int a[];\n    int b[];\n    for (int i = 0; i < m; i++) {\n        append(pa, set(x0, zy[i].y, zy[i].z));\n        append(pb, set(x1, zy[i].y, zy[i].z));\n        append(a, addpoint(0, pa[i]));\n        append(b, addpoint(0, pb[i]));\n        mid += pa[i] + pb[i];\n    }\n    mid = mid / (2 * m);\n    facet(a, pa, mid, piece, color, material);\n    facet(b, pb, mid, piece, color, material);\n    for (int i = 0; i < m; i++) {\n        int j = (i + 1) % m;\n        int q[] = array(a[i], a[j], b[j], b[i]);\n        vector qp[] = array(pa[i], pa[j], pb[j], pb[i]);\n        facet(q, qp, mid, piece, color, material);\n    }\n}\n\n// The gables: on the slab over the upper floor at each end of the house,\n// up under the roof -- their tops lie in the roof's underside. A solid each,\n// for the Voronoi Fracture.\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat t = detail(1, \"thickness\");\nfloat yp = detail(1, \"plinth\") + 2 * (detail(1, \"storey\") + detail(1, \"slab\"));\nfloat ridge = yp + hd * tan(radians(detail(1, \"pitch\")));\nvector zy[] = array(set(0, yp, -hd), set(0, yp, hd), set(0, ridge, 0));\nprism(zy, -hw, -hw + t, 0, chv(\"plaster\"), \"plaster\");\nprism(zy, hw - t, hw, 0, chv(\"plaster\"), \"plaster\");"
  param plaster 0.72 0.6 0.42
node 17 voronoi_fracture 1 gable_pieces 600 220
  param count 30
  param seed 5
node 18 primitive_wrangle 1 gable_finish 600 330
  param snippet "// The gables' pieces numbered on past the slabs'; where they broke, the\n// ceramic of the blocks shows.\ni@piece += 3000000;\ni@kind = 4;\ni@floor = 2;\nvector n = prim_normal(0, @primnum);\nif (@group_inside) {\n    @Cd = chv(\"block\");\n    s@material = \"brick\";\n} else if (abs(n.x) > 0.5 && @P.x * n.x < 0) {\n    @Cd = chv(\"inside\");\n}"
  param block 0.55 0.26 0.15
  param inside 0.7 0.68 0.64
node 19 detail_wrangle 1 roof 840 110
  param snippet "// A polygon through the points ids -- at ps -- turned to face away from mid.\nvoid facet(int ids[]; vector ps[]; vector mid; int piece; vector color; string material) {\n    vector n = set(0, 0, 0);\n    vector c = set(0, 0, 0);\n    int m = len(ps);\n    for (int i = 0; i < m; i++) {\n        vector a = ps[i];\n        vector b = ps[(i + 1) % m];\n        n += set((a.y - b.y) * (a.z + b.z), (a.z - b.z) * (a.x + b.x), (a.x - b.x) * (a.y + b.y));\n        c += a;\n    }\n    c = c / m;\n    int pts[];\n    if (dot(n, c - mid) >= 0) {\n        for (int i = 0; i < m; i++) append(pts, ids[i]);\n    } else {\n        for (int i = m - 1; i >= 0; i--) append(pts, ids[i]);\n    }\n    int pr = addprim(0, \"poly\", pts);\n    setprimattrib(0, \"piece\", pr, piece);\n    setprimattrib(0, \"Cd\", pr, color);\n    setprimattrib(0, \"material\", pr, material);\n}\n\n// A prism: the outline zy -- corners in z and y, in order round it -- from\n// x0 to x1, closed, its corners shared by its faces.\nvoid prism(vector zy[]; float x0; float x1; int piece; vector color; string material) {\n    int m = len(zy);\n    vector mid = set(0, 0, 0);\n    vector pa[];\n    vector pb[];\n    int a[];\n    int b[];\n    for (int i = 0; i < m; i++) {\n        append(pa, set(x0, zy[i].y, zy[i].z));\n        append(pb, set(x1, zy[i].y, zy[i].z));\n        append(a, addpoint(0, pa[i]));\n        append(b, addpoint(0, pb[i]));\n        mid += pa[i] + pb[i];\n    }\n    mid = mid / (2 * m);\n    facet(a, pa, mid, piece, color, material);\n    facet(b, pb, mid, piece, color, material);\n    for (int i = 0; i < m; i++) {\n        int j = (i + 1) % m;\n        int q[] = array(a[i], a[j], b[j], b[i]);\n        vector qp[] = array(pa[i], pa[j], pb[j], pb[i]);\n        facet(q, qp, mid, piece, color, material);\n    }\n}\n\n// The roof: a slope on each side of the ridge, rafters and battens and\n// tiles -- Thickness of them -- out over the walls by Eaves at the bottom\n// and Verge at the gables, its underside on the tops of the front and back\n// walls' slab and on the gables.\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat yp = detail(1, \"plinth\") + 2 * (detail(1, \"storey\") + detail(1, \"slab\"));\nfloat tn = tan(radians(detail(1, \"pitch\")));\nfloat th = ch(\"thickness\") / cos(radians(detail(1, \"pitch\")));\nfloat ov = ch(\"eaves\");\nfloat x = hw + ch(\"verge\");\nfloat ridge = yp + hd * tn;\nfor (int s = -1; s <= 1; s += 2) {\n    vector zy[] = array(set(0, ridge, 0), set(0, yp - ov * tn, s * (hd + ov)),\n                        set(0, yp - ov * tn + th, s * (hd + ov)), set(0, ridge + th, 0));\n    prism(zy, -x, x, 0, set(0.5, 0.5, 0.5), \"roof_tiles\");\n}"
  param thickness 0.28
  param eaves 0.55
  param verge 0.45
node 20 detail_wrangle 1 roof_seeds 1080 110
  param snippet "// Where the roof breaks: points down each slope, Size apart along the\n// ridge and Length down the slope, a little off a grid -- strips of it\n// between the rafters, as a roof of timber breaks.\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat yp = detail(1, \"plinth\") + 2 * (detail(1, \"storey\") + detail(1, \"slab\"));\nfloat a = radians(detail(1, \"pitch\"));\nfloat size = ch(\"size\");\nfloat x0 = hw + ch(\"verge\");\nfloat run = (hd + ch(\"eaves\")) / cos(a);\nfloat mid = yp + hd * tan(a) + 0.5 * ch(\"thickness\") / cos(a);\nint nx = int(rint(2 * x0 / size));\nint ns = max(1, int(rint(run / ch(\"length\"))));\nint k = 0;\nfor (int s = -1; s <= 1; s += 2) {\n    for (int i = 0; i < nx; i++) {\n        for (int j = 0; j < ns; j++) {\n            float u = -x0 + (i + 0.5 + 0.7 * (rand(k * 3 + 1) - 0.5)) * 2 * x0 / nx;\n            float d = (j + 0.5 + 0.7 * (rand(k * 3 + 2) - 0.5)) * run / ns;\n            addpoint(0, set(u, mid - d * sin(a), s * d * cos(a)));\n            k++;\n        }\n    }\n}"
  param size 1
  param length 2.2
  expr verge "ch(\"../roof/verge\")"
  expr eaves "ch(\"../roof/eaves\")"
  expr thickness "ch(\"../roof/thickness\")"
node 21 voronoi_fracture 1 roof_pieces 840 220
node 22 primitive_wrangle 1 roof_finish 840 330
  param snippet "// The roof's pieces numbered on past the gables', light -- timber and\n// tiles, not stone -- and their faces as a roof has them: tiles on top,\n// boards under the eaves, the fascia boards dark; inside each break the\n// timber of the rafters.\ni@piece += 4000000;\ni@kind = 5;\ni@floor = 3;\nf@density = 420;\nvector n = prim_normal(0, @primnum);\nif (@group_inside) {\n    @Cd = set(0.4, 0.27, 0.15);\n    s@material = \"wood\";\n} else if (n.y > 0.3) {\n    @Cd = chv(\"tiles\");\n    s@material = \"roof_tiles\";\n} else if (n.y < -0.3) {\n    @Cd = set(0.42, 0.3, 0.18);\n    s@material = \"wood\";\n} else {\n    @Cd = set(0.12, 0.08, 0.05);\n    s@material = \"wood\";\n}"
  param tiles 0.075 0.08 0.085
node 23 detail_wrangle 1 chimney 1080 220
  param snippet "// A polygon through the points ids -- at ps -- turned to face away from mid.\nvoid facet(int ids[]; vector ps[]; vector mid; int piece; vector color; string material) {\n    vector n = set(0, 0, 0);\n    vector c = set(0, 0, 0);\n    int m = len(ps);\n    for (int i = 0; i < m; i++) {\n        vector a = ps[i];\n        vector b = ps[(i + 1) % m];\n        n += set((a.y - b.y) * (a.z + b.z), (a.z - b.z) * (a.x + b.x), (a.x - b.x) * (a.y + b.y));\n        c += a;\n    }\n    c = c / m;\n    int pts[];\n    if (dot(n, c - mid) >= 0) {\n        for (int i = 0; i < m; i++) append(pts, ids[i]);\n    } else {\n        for (int i = m - 1; i >= 0; i--) append(pts, ids[i]);\n    }\n    int pr = addprim(0, \"poly\", pts);\n    setprimattrib(0, \"piece\", pr, piece);\n    setprimattrib(0, \"Cd\", pr, color);\n    setprimattrib(0, \"material\", pr, material);\n}\n\n// A prism: the outline zy -- corners in z and y, in order round it -- from\n// x0 to x1, closed, its corners shared by its faces.\nvoid prism(vector zy[]; float x0; float x1; int piece; vector color; string material) {\n    int m = len(zy);\n    vector mid = set(0, 0, 0);\n    vector pa[];\n    vector pb[];\n    int a[];\n    int b[];\n    for (int i = 0; i < m; i++) {\n        append(pa, set(x0, zy[i].y, zy[i].z));\n        append(pb, set(x1, zy[i].y, zy[i].z));\n        append(a, addpoint(0, pa[i]));\n        append(b, addpoint(0, pb[i]));\n        mid += pa[i] + pb[i];\n    }\n    mid = mid / (2 * m);\n    facet(a, pa, mid, piece, color, material);\n    facet(b, pb, mid, piece, color, material);\n    for (int i = 0; i < m; i++) {\n        int j = (i + 1) % m;\n        int q[] = array(a[i], a[j], b[j], b[i]);\n        vector qp[] = array(pa[i], pa[j], pb[j], pb[i]);\n        facet(q, qp, mid, piece, color, material);\n    }\n}\n\n// The chimney: brick, through the back slope of the roof near the ridge --\n// standing on the roof's tiles, its foot cut to their slope -- and a cap of\n// concrete on top.\nfloat hd = detail(1, \"depth\") / 2;\nfloat yp = detail(1, \"plinth\") + 2 * (detail(1, \"storey\") + detail(1, \"slab\"));\nfloat a = radians(detail(1, \"pitch\"));\nfloat top = yp + hd * tan(a) + ch(\"thickness\") / cos(a);  // the ridge's top\nvector c = chv(\"center\");\nvector s = chv(\"size\");\nfloat z0 = c.z - s.z / 2;\nfloat z1 = c.z + s.z / 2;\nfloat h = top + ch(\"height\");\n// The back slope's top: down from the ridge as z goes out.\nvector zy[] = array(set(0, top + z0 * tan(a), z0), set(0, top + z1 * tan(a), z1), set(0, h, z1), set(0, h, z0));\nprism(zy, c.x - s.x / 2, c.x + s.x / 2, 0, chv(\"color\"), \"brick_wall\");\nvector cap[] = array(set(0, h, z0 - 0.05), set(0, h, z1 + 0.05), set(0, h + 0.08, z1 + 0.05), set(0, h + 0.08, z0 - 0.05));\nprism(cap, c.x - s.x / 2 - 0.05, c.x + s.x / 2 + 0.05, 1, set(0.42, 0.41, 0.39), \"concrete\");"
  param center 2.2 0 -1.65
  param size 0.6 0 0.5
  param height 1
  param color 0.3 0.12 0.08
  expr thickness "ch(\"../roof/thickness\")"
