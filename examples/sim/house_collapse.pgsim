node 45 merge 1 house 840 880
node 46 primitive_wrangle 1 charges 840 990
  param snippet "// The collapse. The walls of the ground floor give way, the left side\n// first, the right a moment (Lag) later: their foot -- Blast Height of them\n// -- bursts to dust (vanish), and of the masonry above it a share\n// (Pulverized) goes the same way, the rest coming loose (release), pushed\n// out of the house (kick). What stood on them -- the upper floor, the\n// slabs, the gables and the roof -- drops, leaning to the left, and breaks\n// up where it lands: the walls of the upper floor crush to dust under what\n// falls on them (crush), the slabs only under a hard blow; the roof, light,\n// breaks into strips. Glass and frames hold less than the mortar.\nfloat fire = ch(\"fire\");\nfloat lag = ch(\"lag\");\nfloat push = ch(\"push\");\nfloat base = detail(1, \"plinth\");\ni@active = i@kind != 0 && !(i@kind == 9 && i@post == 1);\nf@glue = 1;\nf@release = 0;\ni@vanish = 0;\nv@kick = set(0, 0, 0);\nf@crush = 0;\nif (i@kind == 1 || i@kind == 2) {\n    f@crush = ch(\"crush\");\n    if (i@floor == 0) {\n        float y = @P.y - base;\n        f@release = fire + lag * smoothstep(-4, 4, @P.x) + 0.05 * y + 0.06 * rand(i@piece);\n        i@vanish = rand(i@piece + 3) < (y < ch(\"blast_height\") ? 0.85 : ch(\"pulverized\"));\n        vector away = set(@P.x, 0, @P.z);\n        v@kick = normalize(away) * push * (0.3 + 0.7 * rand(i@piece + 17)) * (i@kind == 1 ? 1 : 0.3)\n               + set(0, 0.3 * rand(i@piece + 23), 0);\n    }\n}\nif (i@kind == 3) {\n    f@glue = 2;\n    f@crush = ch(\"crush_slabs\");\n}\nif (i@kind == 5) f@glue = 0.35;\nif (i@kind == 7) f@glue = 0.6;\nif (i@kind == 8) f@glue = 0.4;\nif (i@kind == 9) f@glue = 0.5;"
  param fire 1
  param lag 0.3
  param push 0.8
  param crush 4
  param blast_height 0.6
  param pulverized 0.35
  param crush_slabs 5
