node 11 primitive_wrangle 1 finish_inner 120 550
  param snippet "// Each wall's blocks numbered on from the walls before it -- no two share a\n// number -- with the wall and the floor they are of, and plastered as a\n// house is: the plaster outside the facade's colour (Plaster), inside white\n// (Inside) -- and the faces round the openings too, where Brick Wall leaves\n// the ends of the blocks bare: a face that looks along the wall, or up or\n// down within its height, with air in front of it -- outside the wall's\n// boxes (input 1).\nint it = detail(1, \"iteration\");\ni@piece += 100000 * (it + chi(\"first\"));\ni@wall = prim(1, \"wall\", 0);\ni@floor = i@wall < 8 ? i@wall % 2 : i@wall - 8;\ni@kind = i@wall < 8 ? 1 : 2;\nvector n = prim_normal(0, @primnum);\nvector lo = getbbox_min(1);\nvector hi = getbbox_max(1);\nvector size = hi - lo;\nvector across = size.x < size.z ? set(1, 0, 0) : set(0, 0, 1);\nvector out = across * (dot(getbbox_center(1), across) < 0 ? -1 : 1);\nif (s@material == \"plaster\" && dot(n, out) < -0.5) @Cd = chv(\"inside\");\nint level = abs(n.y) > 0.5;\nint edge = level && (@P.y < lo.y + 0.01 || @P.y > hi.y - 0.01);\nif (abs(dot(n, across)) < 0.5 && !edge) {\n    vector q = @P + n * 0.005;\n    int air = 1;\n    for (int b = 0; b + 5 < nprimitives(1); b += 6) {\n        vector a = set(1e9, 1e9, 1e9);\n        vector z = set(-1e9, -1e9, -1e9);\n        for (int f = 0; f < 2; f++) {\n            foreach (int pt; primpoints(1, b + f)) {\n                vector p = point(1, \"P\", pt);\n                a = set(min(a.x, p.x), min(a.y, p.y), min(a.z, p.z));\n                z = set(max(z.x, p.x), max(z.y, p.y), max(z.z, p.z));\n            }\n        }\n        if (q.x > a.x && q.x < z.x && q.y > a.y && q.y < z.y && q.z > a.z && q.z < z.z) air = 0;\n    }\n    if (air) {\n        @Cd = chv(\"plaster\");\n        s@material = \"plaster\";\n    }\n}"
  param first 9
  param inside 0.7 0.68 0.64
  param plaster 0.7 0.68 0.64
node 12 foreach_end 1 inner_walls 120 660
node 13 detail_wrangle 1 slabs 360 110
  param snippet "// The two slabs of concrete, on the walls of the floor below: the ceiling\n// of the ground floor and of the upper one -- the walls of the floor above\n// and the gables stand on them.\nvoid slab(float y0; float y1; float hw; float hd) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hw : -hw, i & 2 ? y1 : y0, i & 4 ? hd : -hd)));\n    }\n    addprim(0, \"poly\", p[0], p[4], p[6], p[2]);\n    addprim(0, \"poly\", p[1], p[3], p[7], p[5]);\n    addprim(0, \"poly\", p[0], p[1], p[5], p[4]);\n    addprim(0, \"poly\", p[2], p[6], p[7], p[3]);\n    addprim(0, \"poly\", p[0], p[2], p[3], p[1]);\n    addprim(0, \"poly\", p[4], p[5], p[7], p[6]);\n}\n\nfloat hw = detail(1, \"width\") / 2;\nfloat hd = detail(1, \"depth\") / 2;\nfloat base = detail(1, \"plinth\");\nfloat storey = detail(1, \"storey\");\nfloat s = detail(1, \"slab\");\nfor (int fl = 0; fl < 2; fl++) {\n    float y0 = base + storey + fl * (storey + s);\n    slab(y0, y0 + s, hw, hd);\n}"
node 14 concrete_fracture 1 slab_pieces 360 220
  param count 70
  param seed 3
  param uneven 0.6
