node 43 detail_wrangle 1 front_fence 2040 660
  param snippet "// The fence along the street, in pieces -- what flies out of the house\n// breaks it: posts set in the ground (post: they stay), two rails across\n// them, pickets a hand apart nailed to the rails; a gate's width open at\n// the path and at the drive. Each a piece of its own.\nint piece = 8000000;\nvoid part(vector lo; vector hi; int piece; int post; vector color) {\n    int p[];\n    for (int i = 0; i < 8; i++) {\n        append(p, addpoint(0, set(i & 1 ? hi.x : lo.x, i & 2 ? hi.y : lo.y, i & 4 ? hi.z : lo.z)));\n    }\n    int f[];\n    append(f, addprim(0, \"poly\", p[0], p[4], p[6], p[2]));\n    append(f, addprim(0, \"poly\", p[1], p[3], p[7], p[5]));\n    append(f, addprim(0, \"poly\", p[0], p[1], p[5], p[4]));\n    append(f, addprim(0, \"poly\", p[2], p[6], p[7], p[3]));\n    append(f, addprim(0, \"poly\", p[0], p[2], p[3], p[1]));\n    append(f, addprim(0, \"poly\", p[4], p[5], p[7], p[6]));\n    for (int k = 0; k < 6; k++) {\n        setprimattrib(0, \"piece\", f[k], piece);\n        setprimattrib(0, \"post\", f[k], post);\n        setprimattrib(0, \"Cd\", f[k], color);\n        setprimattrib(0, \"material\", f[k], \"wood\");\n    }\n}\n\nvector c = chv(\"color\");\nfloat z = ch(\"z\");\nfloat runs[] = array(-16, -0.75, 0.75, 5.95, 9.05, 16);\nfor (int r = 0; r < len(runs); r += 2) {\n    float a = runs[r];\n    float b = runs[r + 1];\n    int posts = int(ceil((b - a) / 2.4));\n    for (int i = 0; i <= posts; i++) {\n        float x = a + (b - a) * i / posts;\n        part(set(x - 0.05, 0, z - 0.1), set(x + 0.05, 1.2, z), piece, 1, c * 0.8);\n        piece++;\n        if (i == posts) continue;\n        float x1 = a + (b - a) * (i + 1) / posts;\n        for (int k = 0; k < 2; k++) {\n            float y = k == 0 ? 0.25 : 0.85;\n            part(set(x, y, z), set(x1, y + 0.07, z + 0.04), piece, 0, c * 0.9);\n            piece++;\n        }\n    }\n    int n = int((b - a) / 0.14);\n    for (int i = 0; i < n; i++) {\n        float x = a + (i + 0.5) * (b - a) / n;\n        float h = 1.05 + 0.03 * (rand(i * 1.3 + a) - 0.5);\n        part(set(x - 0.045, 0, z + 0.04), set(x + 0.045, h, z + 0.062), piece, 0, c * (0.85 + 0.3 * rand(i * 7.1 + a)));\n        piece++;\n    }\n}"
  param color 0.33 0.21 0.12
  param z 9.5
