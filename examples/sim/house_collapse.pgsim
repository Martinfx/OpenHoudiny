  param snippet "// The lawn of the front garden, as grass grows: where it may (grass) -- not\n// on the path or the drive, thinner by the house and the fence.\nfloat path = @P.x > -0.8 && @P.x < 0.8 ? 1 : 0;\nfloat drive = @P.x > 5.9 && @P.x < 9.1 ? 1 : 0;\nf@grass = (1 - max(path, drive)) * smoothstep(4.7, 5.3, @P.z) * (1 - smoothstep(9.0, 9.35, @P.z));\n@P.y = 0.004;"
