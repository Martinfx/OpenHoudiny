node 30 point_wrangle 1 canon 1560 330
  param snippet "// The pane laid at the middle of the world facing z -- where Glass Fracture\n// strikes it (Impact 0 0 0) -- turned in its plane and shifted a little\n// each time round, so that no two break alike.\nint it = detail(0, \"iteration\");\nvector c = getbbox_center(0);\nvector s = getbbox_size(0);\nvector p = @P - c;\nif (s.x < s.z) p = set(p.z, p.y, -p.x);\nfloat a = radians(360 * rand(it * 7.13 + 0.5));\np = set(p.x * cos(a) - p.y * sin(a), p.x * sin(a) + p.y * cos(a), p.z);\n@P = p + set(rand(it * 3.1 + 0.2) - 0.5, rand(it * 5.3 + 0.7) - 0.5, 0) * 0.3;"
