pgsim 1
# Seven trees of one Tree node's seven crown shapes, each set as a kind of
# tree grows: a spruce (conical, one trunk to its top, needles), an oak
# (spherical, the trunk forking into three leaders), a birch (flame, white
# bark, twigs hanging), a poplar (cylindrical, its branches up along the
# trunk), an acacia (umbrella, forking wide, flat on top), a willow
# (weeping, long twigs hanging to the ground) and a lime (hemispherical).
# The camera in front of the row, every tree whole in the picture.
node 1 tree 1 spruce 0 0
  param shape conical
  param height 11
  param radius 0.2
  param center -27 0 0
  param crown 0.06
  param levels 2
  param gravity 0.35
  param up 0.05
  param branches1 64
  param angle1 80
  param length1 0.3
  param branches2 12
  param angle2 55
  param leaves 16
  param leafsize 0.22
  param leafshape needles
  param barkcolor 0.1 0.08 0.065
  param leafcolor 0.035 0.08 0.035
