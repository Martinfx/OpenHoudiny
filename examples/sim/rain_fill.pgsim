pgsim 1
# A downpour fills a stone basin: every drop that falls in rings the water
# and adds to it, as if all the rain over the basin fell into it -- the
# water rises some 7 centimetres in five seconds, over the step inside.
node 1 water_source 1 water 0 0
  param center 0 0.04 0
  param size 1.2 0.08 1.2
node 2 object 1 step 0 96
  param center 0.3 0.06 0.2
  param size 0.4 0.12 0.4
  param color 0.42 0.4 0.37
node 3 liquid_solver 1 solver 250 0
  param size 1.2 0.5 1.2
node 4 water_look 1 look 490 0
node 5 rain 1 rain 490 150
  param size 1.2 0.4 1.2
  param rate 1500
  param fill 15
node 6 output 2 output 720 60
  param light_intensity 1.2
  param sky_intensity 0.4
node 7 camera 1 camera 720 300
  param center 1.25 0.6 1.35
  param rotation -16 41.5 0
  param focal 32
link 1.water -> 3.sources
link 2.collider -> 3.colliders
link 2.collider -> 5.colliders
link 3.liquid -> 4.liquid
link 4.look -> 6.look
link 5.look -> 6.look
link 7.camera -> 6.camera
