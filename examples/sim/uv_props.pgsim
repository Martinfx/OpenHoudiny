pgsim 1
# Texture coordinates: a crate, a column and a ball, each with its uv from a
# UV Project -- the six sides of a box, once round the column, round the
# ball from pole to pole -- and a photograph of the library laid on by it
# (Material, Projection UV): wood, a brick wall. Their normal maps bend the
# light: the joints of the bricks catch the sun, in both renderers.
#   prototype sim uv_props uv.png --renderer cycles
node 1 box 1 crate 0 0
  param size 0.8 0.8 0.8
  param center -1.05 0.4 0.1
node 2 uv_project 1 crate_uv 230 0
  param projection box
  param scale 0.8
node 3 material 1 crate_wood 460 0
  param material wood
  param texture_projection uv
node 4 tube 1 column 0 130
  param radius 0.32
  param height 1.5
  param center 0 0.75 -0.3
  param columns 64
node 5 uv_project 1 column_uv 230 130
  param projection cylindrical
  param center 0 0 -0.3
  param scale 2
node 6 material 1 column_bricks 460 130
  param material brick_wall
  param texture_projection uv
node 7 sphere 1 ball 0 260
  param radius 0.42
  param center 1.05 0.42 0.15
  param rows 32
  param columns 64
node 8 uv_project 1 ball_uv 230 260
  param projection spherical
  param center 1.05 0.42 0.15
node 9 material 1 ball_bricks 460 260
  param material brick_wall
  param texture_projection uv
  param texture_normal 1.5
node 10 merge 1 props 690 130
  display
link 1.geometry -> 2.geometry
link 2.geometry -> 3.geometry
link 4.geometry -> 5.geometry
link 5.geometry -> 6.geometry
link 7.geometry -> 8.geometry
link 8.geometry -> 9.geometry
link 3.geometry -> 10.geometry
link 6.geometry -> 10.geometry
link 9.geometry -> 10.geometry
