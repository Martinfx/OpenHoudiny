#version 450
#extension GL_GOOGLE_include_directive : require
#include "keep.glsl"
// y = a x + y over n floats: the device's memory read twice and written once
// for every number -- how fast it moves data (prototype gpu).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) buffer Y { float y[]; };
layout(push_constant) uniform Push {
    uint n;
    float a;
} p;

void main() {
    // As many groups as the device takes at once, each going on over the
    // rest in steps of all of them.
    const uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += step) y[i] = p.a * x[i] + y[i];
}
