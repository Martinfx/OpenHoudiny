#version 450
#extension GL_GOOGLE_include_directive : require
#include "keep.glsl"
// Walls: the faces a list holds given their velocity -- 0, or what a moving
// solid gives them -- one component (p.axis) -- PyroSolver::enforceWalls.
// The list: where each face is in its component, its velocity's bits.
// p.field where the list starts, p.slotCount how long it is.
layout(local_size_x = 256) in;
#include "sparse.glsl"
layout(std430, binding = 1) buffer Velocity { float V[]; };
layout(std430, binding = 2) readonly buffer Faces { uint faces[]; };

void main() {
    const uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < p.slotCount; i += step) {
        V[p.vel[p.axis] + faces[p.field + 2u * i]] = uintBitsToFloat(faces[p.field + 2u * i + 1u]);
    }
}
