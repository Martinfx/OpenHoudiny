#version 450
#extension GL_GOOGLE_include_directive : require
#include "keep.glsl"
// Smoke thins, heat cools, flame and steam fade, and what the swelling gas
// carries spreads over its room -- PyroSolver::dissipate. f: smoke's, heat's,
// flame's and steam's factors this step, dt; kHasSteam whether steam is.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
#include "sparse.glsl"
#include "exact.glsl"
layout(std430, binding = 1) buffer Fields { float S[]; };

void main() {
    for (uint part = 0u; part < 2u; ++part) {
        uint slot;
        ivec3 c;
        if (!cellOf(0, part, slot, c)) continue;
        const uint at = indexOf(slot, c);
        const uint P = p.plane;
        precise float room = 1.0 + S[kExpansion * P + at] * p.f[4];
        const float thinner = exactDiv(1.0, room);
        precise float smoke = mx(0.0, S[kDensity * P + at]) * p.f[0] * thinner;
        precise float heat = mx(0.0, S[kTemperature * P + at]) * p.f[1];
        precise float fuel = mx(0.0, S[kFuel * P + at]) * thinner;
        precise float flame = mx(0.0, S[kFlame * P + at]) * p.f[2] * thinner;
        S[kDensity * P + at] = smoke;
        S[kTemperature * P + at] = heat;
        S[kFuel * P + at] = fuel;
        S[kFlame * P + at] = flame;
        if ((p.flags & kHasSteam) != 0u) {
            precise float steam = mx(0.0, S[kSteam * P + at]) * p.f[3] * thinner;
            S[kSteam * P + at] = steam;
        }
    }
}
