#version 450
#extension GL_GOOGLE_include_directive : require
#include "keep.glsl"
// No gas inside a solid: the cells a list holds emptied of smoke, heat, fuel,
// flame and steam -- PyroSolver::finishAdvect. p.slotCount: how many.
layout(local_size_x = 256) in;
#include "sparse.glsl"
layout(std430, binding = 1) buffer Fields { float S[]; };
layout(std430, binding = 2) readonly buffer Cells { uint cells[]; };

void main() {
    const uint step = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < p.slotCount; i += step) {
        const uint at = cells[p.field + i];
        for (uint f = kDensity; f <= kSteam; ++f) S[f * p.plane + at] = 0.0;
    }
}
