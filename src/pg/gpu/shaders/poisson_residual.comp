#version 450
#extension GL_GOOGLE_include_directive : require
#include "keep.glsl"
// r = b - A p on one level, in the cells that count --
// PoissonSolver::computeResidual.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
#include "poisson.glsl"

void main() {
    uint slot;
    ivec3 corner;
    if (!tileOf(slot, corner)) return;
    const ivec3 n = level();
    for (int half_ = 0; half_ < 2; ++half_) {
        const ivec3 c = corner + ivec3(gl_LocalInvocationID.xy, int(gl_LocalInvocationID.z) + 4 * half_);
        if (any(greaterThanEqual(c, n))) continue;
        const uint index = indexOf(slot, c);
        if (!counts(index)) continue;
        const float rhs = F[p.b + index];
        const float v = F[p.p + index];
        if (p.mode == 0) {
            float diagonal;
            const float sum = neighbours(c, diagonal);
            precise float r = rhs - (sum - diagonal * v) * p.invH2;
            F[p.r + index] = r;
            continue;
        }
        const float d = F[p.diag + index];
        const float sum = p.mode == 1 ? openSum(c, index) : weightedSum(c);
        precise float r = rhs - (sum - d * v) * p.invH2;
        F[p.r + index] = d <= 0.0 ? 0.0 : r;
    }
}
