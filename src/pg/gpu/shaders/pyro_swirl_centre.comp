#version 450
#extension GL_GOOGLE_include_directive : require
#include "keep.glsl"
// Vorticity confinement, first: the velocity at the cells' centres, into
// planes 0 to 2 of the scratch -- PyroSolver::addVorticity.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
#include "sparse.glsl"
layout(std430, binding = 1) readonly buffer Velocity { float V[]; };
layout(std430, binding = 2) writeonly buffer Scratch { float P[]; };

float velAt(int a, int i, int j, int k) {
    const int at = find(a + 1, sizeOf(a + 1), i, j, k);
    return at < 0 ? 0.0 : V[p.vel[a] + uint(at)];
}

void main() {
    for (uint part = 0u; part < 2u; ++part) {
        uint slot;
        ivec3 c;
        if (!cellOf(0, part, slot, c)) continue;
        const uint at = indexOf(slot, c);
        precise float u = 0.5 * (velAt(0, c.x, c.y, c.z) + velAt(0, c.x + 1, c.y, c.z));
        precise float v = 0.5 * (velAt(1, c.x, c.y, c.z) + velAt(1, c.x, c.y + 1, c.z));
        precise float w = 0.5 * (velAt(2, c.x, c.y, c.z) + velAt(2, c.x, c.y, c.z + 1));
        P[at] = u;
        P[p.plane + at] = v;
        P[2u * p.plane + at] = w;
    }
}
