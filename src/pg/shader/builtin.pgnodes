# OpenHoudiny shader graph -- the built-in node library.
#
# Every node the editor offers is defined here, in the same format a user
# library uses (see src/pg/shader/NodeLibrary.h). The C++ code knows nothing
# about any of these nodes; copy a block into your own .pgnodes file, change it,
# and load it with `pgshader --library` or the editor's Library menu.
#
# Templates are written in the neutral dialect -- GLSL syntax. Each target
# translates identifiers (vec3 -> float3, mix -> lerp, ...) into its language;
# where that is not enough, `impl <target> <output> = ...` gives a template of
# its own (see `texture`).

# --- Input -------------------------------------------------------------------

node uv
    label UV
    category Input
    description Texture coordinates of the mesh.
    out uv vec2 = $uv

node position
    label Position
    category Input
    description World-space position of the surface.
    out position vec3 = $position

node normal
    label Normal
    category Input
    description World-space unit normal of the surface.
    out normal vec3 = $normal

node view_direction
    label View Direction
    category Input
    description Unit vector from the surface towards the camera.
    out view vec3 = $view

node light_direction
    label Light Direction
    category Input
    description Unit vector from the surface towards the light.
    out light vec3 = $light

node time
    label Time
    category Input
    description Seconds since the start -- animates whatever it feeds.
    out time float = $time

node constant
    label Constant
    category Input
    description A number baked into the shader.
    param value float = 1.0
    out result float = {value}

node color
    label Color
    category Input
    description A colour baked into the shader.
    param rgb vec3 = 0.8 0.3 0.2 color
    out color vec3 = {rgb}

node float_parameter
    label Float Parameter
    category Input
    description A uniform u_<name> that the application can change without recompiling.
    param name string = amount
    param default float = 0.5
    uniform u_{name} float = {default}
    out value float = u_{name}

node color_parameter
    label Color Parameter
    category Input
    description A colour uniform u_<name> that the application can change without recompiling.
    param name string = tint
    param default vec3 = 1.0 0.5 0.2 color
    uniform u_{name} vec3 = {default}
    out color vec3 = u_{name}

# --- Math --------------------------------------------------------------------
#
# `any` ports take the widest type connected to them: add a vec3 and a float
# and you get a vec3.

node add
    label Add
    category Math
    in a any = 0.0
    in b any = 0.0
    out result any = {a} + {b}

node subtract
    label Subtract
    category Math
    in a any = 0.0
    in b any = 0.0
    out result any = {a} - {b}

node multiply
    label Multiply
    category Math
    in a any = 1.0
    in b any = 1.0
    out result any = {a} * {b}

node divide
    label Divide
    category Math
    in a any = 1.0
    in b any = 1.0
    out result any = {a} / {b}

node mix
    label Mix
    category Math
    description Blends a and b: t = 0 gives a, t = 1 gives b.
    in a any = 0.0
    in b any = 1.0
    in t float = 0.5
    out result any = mix({a}, {b}, {t})

node one_minus
    label One Minus
    category Math
    in x any = 0.0
    out result any = 1.0 - {x}

node power
    label Power
    category Math
    in base any = 1.0
    in exponent any = 2.0
    out result any = pow({base}, {exponent})

node sine
    label Sine
    category Math
    in x any = 0.0
    out result any = sin({x})

node fract
    label Fraction
    category Math
    description The part after the decimal point: repeats every 1.
    in x any = 0.0
    out result any = fract({x})

node saturate
    label Saturate
    category Math
    description Clamps to [0, 1].
    in x any = 0.0
    out result any = clamp({x}, 0.0, 1.0)

node smoothstep
    label Smoothstep
    category Math
    description 0 below edge0, 1 above edge1, a smooth curve between.
    in edge0 float = 0.0
    in edge1 float = 1.0
    in x any = 0.5
    out result any = smoothstep({edge0}, {edge1}, {x})

node remap
    label Remap
    category Math
    description Maps x from [from_min, from_max] onto [to_min, to_max].
    in x any = 0.5
    in from_min float = 0.0
    in from_max float = 1.0
    in to_min float = 0.0
    in to_max float = 1.0
    out result any = {to_min} + ({x} - {from_min}) / ({from_max} - {from_min}) * ({to_max} - {to_min})

# --- Vector ------------------------------------------------------------------

node dot
    label Dot Product
    category Vector
    in a vec3 = 0 0 1
    in b vec3 = 0 0 1
    out result float = dot({a}, {b})

node normalize
    label Normalize
    category Vector
    in v vec3 = 0 0 1
    out result vec3 = normalize({v})

node length
    label Length
    category Vector
    in v any = 0.0
    out result float = length({v})

node combine
    label Combine XYZ
    category Vector
    in x float = 0.0
    in y float = 0.0
    in z float = 0.0
    out vector vec3 = vec3({x}, {y}, {z})

node split
    label Split XYZ
    category Vector
    in vector vec3 = 0 0 0
    out x float = {vector}.x
    out y float = {vector}.y
    out z float = {vector}.z

# --- Texture -----------------------------------------------------------------

node texture
    label Texture
    category Texture
    description Samples the 2D texture the application binds as u_<name>.
    param name string = albedo
    uniform u_{name} sampler2D
    in uv vec2 = $uv
    out rgba vec4 = texture(u_{name}, {uv})
    impl hlsl rgba = u_{name}.Sample(u_{name}_sampler, {uv})
    out rgb vec3 = {rgba}.rgb
    out alpha float = {rgba}.a

# --- Pattern -----------------------------------------------------------------

node checker
    label Checker
    category Pattern
    in uv vec2 = $uv
    in scale float = 8.0
    in color1 vec3 = 0.15 0.15 0.15 color
    in color2 vec3 = 0.85 0.85 0.85 color
    uses pg_checker
    out color vec3 = mix({color1}, {color2}, pg_checker({uv} * {scale}))
    out mask float = pg_checker({uv} * {scale})

node noise
    label Noise
    category Pattern
    description Smooth value noise between 0 and 1.
    in uv vec2 = $uv
    in scale float = 4.0
    uses pg_noise
    out value float = pg_noise({uv} * {scale})

# Clouds, fire, smoke: noise at several sizes added up. Moving `offset` over
# time scrolls it (y) and makes it churn (z); it is in noise cells, so the
# speed does not change with the scale.
node fractal_noise
    label Fractal Noise
    category Pattern
    description Octaves of 3D value noise added up, between 0 and 1. Animate it through offset.
    in position vec3 = $position
    in scale float = 3.0
    in offset vec3 = 0 0 0
    in octaves float = 5.0
    in roughness float = 0.5
    uses pg_fbm3
    out value float = pg_fbm3({position} * {scale} + {offset}, {octaves}, {roughness})

# --- Color -------------------------------------------------------------------

node color_ramp
    label Color Ramp
    category Color
    description Maps t from 0 to 1 onto four colours; the middle two sit at pos1 and pos2.
    in t float = 0.5
    in color0 vec3 = 0.0 0.0 0.0 color
    in color1 vec3 = 0.75 0.08 0.02 color
    in color2 vec3 = 1.0 0.55 0.1 color
    in color3 vec3 = 1.0 0.95 0.75 color
    in pos1 float = 0.35
    in pos2 float = 0.7
    uses pg_ramp4
    out color vec3 = pg_ramp4({t}, {color0}, {color1}, {color2}, {color3}, {pos1}, {pos2})

node rgba
    label Color + Alpha
    category Color
    description A colour and its opacity, for an output that blends.
    in rgb vec3 = 1.0 1.0 1.0 color
    in alpha float = 1.0
    out rgba vec4 = vec4({rgb}, {alpha})

# --- Lighting ----------------------------------------------------------------

node lambert
    label Lambert
    category Lighting
    description Diffuse light from one directional light, plus ambient.
    in color vec3 = 0.8 0.8 0.8 color
    in normal vec3 = $normal
    in light vec3 = $light
    in ambient float = 0.15
    out result vec3 = {color} * ({ambient} + (1.0 - {ambient}) * max(dot(normalize({normal}), normalize({light})), 0.0))

node blinn_phong
    label Blinn-Phong Specular
    category Lighting
    description The highlight of a shiny surface; higher shininess, smaller spot.
    in normal vec3 = $normal
    in light vec3 = $light
    in view vec3 = $view
    in shininess float = 32.0
    out specular float = pow(max(dot(normalize({normal}), normalize({light} + {view})), 0.0), {shininess})

node fresnel
    label Fresnel
    category Lighting
    description Rises towards 1 where the surface turns away from the camera.
    in normal vec3 = $normal
    in view vec3 = $view
    in power float = 5.0
    out result float = pow(1.0 - clamp(dot(normalize({normal}), normalize({view})), 0.0, 1.0), {power})

# --- Output ------------------------------------------------------------------

# `blend` is not code but render state -- how the colour meets what is already
# on screen. The generator reports it; the application sets it.
node surface_output
    label Surface Output
    category Output
    description The result: the colour of each pixel, and an optional world-space offset of each vertex. Alpha matters when blend is alpha or additive.
    kind output
    in color vec4 = 0.8 0.8 0.8 1.0 color stage fragment
    in offset vec3 = 0 0 0 stage vertex
    param blend enum opaque alpha additive = opaque

# --- Helper functions --------------------------------------------------------
#
# Emitted once, in each stage that uses them, before the code that calls them.

function pg_checker
float pg_checker(vec2 p) {
    vec2 c = floor(p);
    float s = c.x + c.y;
    return s - 2.0 * floor(s * 0.5);
}
end

function pg_hash
float pg_hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}
end

function pg_noise
uses pg_hash
float pg_noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float a = pg_hash(i);
    float b = pg_hash(i + vec2(1.0, 0.0));
    float c = pg_hash(i + vec2(0.0, 1.0));
    float d = pg_hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
end

function pg_hash3
float pg_hash3(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}
end

function pg_noise3
uses pg_hash3
float pg_noise3(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float a = pg_hash3(i);
    float b = pg_hash3(i + vec3(1.0, 0.0, 0.0));
    float c = pg_hash3(i + vec3(0.0, 1.0, 0.0));
    float d = pg_hash3(i + vec3(1.0, 1.0, 0.0));
    float e = pg_hash3(i + vec3(0.0, 0.0, 1.0));
    float g = pg_hash3(i + vec3(1.0, 0.0, 1.0));
    float h = pg_hash3(i + vec3(0.0, 1.0, 1.0));
    float k = pg_hash3(i + vec3(1.0, 1.0, 1.0));
    return mix(mix(mix(a, b, u.x), mix(c, d, u.x), u.y),
               mix(mix(e, g, u.x), mix(h, k, u.x), u.y), u.z);
}
end

# At most 8 octaves: a loop with a constant bound, which every target accepts.
function pg_fbm3
uses pg_noise3
float pg_fbm3(vec3 p, float octaves, float roughness) {
    float sum = 0.0;
    float amplitude = 0.5;
    float total = 0.0;
    for (int i = 0; i < 8; ++i) {
        if (float(i) >= octaves) break;
        sum += amplitude * pg_noise3(p);
        total += amplitude;
        p = p * 2.03 + vec3(17.1, 5.3, 11.7);
        amplitude *= roughness;
    }
    return sum / max(total, 0.0001);
}
end

function pg_ramp4
vec3 pg_ramp4(float t, vec3 c0, vec3 c1, vec3 c2, vec3 c3, float p1, float p2) {
    t = clamp(t, 0.0, 1.0);
    if (t < p1) return mix(c0, c1, t / max(p1, 0.0001));
    if (t < p2) return mix(c1, c2, (t - p1) / max(p2 - p1, 0.0001));
    return mix(c2, c3, (t - p2) / max(1.0 - p2, 0.0001));
}
end
